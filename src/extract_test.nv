// SPDX-License-Identifier: MIT OR Apache-2.0
// Plan 222.3 — `FromRequest` extractors: peer tests. Ф.1 (ParamsDeserializer/
// QueryDeserializer — pure parser tests, no http context) + Ф.2 (`Bytes`/
// `Text`/`Headers` via `#impl(FromRequest)`, driven end-to-end through a real
// `Router` dispatch — mirrors `router_test.nv`/`server_test.nv`'s own "build a
// raw HTTP/1.1 request, serve_once, inspect the wire response" style so no
// mock-`ServerRequest` constructor is needed).
//
// `PathParam[T]`/`Query[T]`/`Json[T]` round-trip tests (below, Ф.2b) were
// blocked by `[M-generic-static-method-value-arg-addr-mismatch]` (221.1 №26:
// `SomeGeneric[Concrete].from_request(req)` emitted `&(req)` — the
// argument's address — at the call site while the generated callee took
// `req` BY VALUE, `unknown pointer→value` CC-FAIL). CLOSED on nova main
// (`9300db349` "four parallel generic mono-instance signature paths never
// consulted the byref map", merged `4dc7c50f4`) — reran with a nova.exe
// rebuilt from that commit, all three now PASS end-to-end.
//
// Ф.3 (222.3 §5, arity-overload handler registration) tests are further
// below: `Router.@get`/`@post`/etc. with 0..N `FromRequest` extractors.

module polaris

import std.encoding.serde.{Serialize, Deserialize}
import std.reflect.{Reflect, TypeShape}

// `get_req` already defined in router_test.nv (same module, no re-declare).
fn post_json_req(path str, body str) -> []u8 =>
    "POST ${path} HTTP/1.1\r\nHost: x\r\nContent-Type: application/json\r\nContent-Length: ${body.byte_len()}\r\n\r\n${body}".bytes()
fn post_text_req(path str, body str) -> []u8 =>
    "POST ${path} HTTP/1.1\r\nHost: x\r\nContent-Length: ${body.byte_len()}\r\n\r\n${body}".bytes()

// ── Ф.1: ParamsDeserializer / QueryDeserializer — pure parser tests ───────

test "ParamsDeserializer: enter_field + deser_int/deser_str round-trip" {
    mut d = ParamsDeserializer.new([("id", "42"), ("name", "gizmo")])
    // `mut` from the start (D246 canon (a)) — no separate copy needed, this
    // sub-cursor is used exactly once, right below.
    mut d1 = d.enter_field("id")!!
    assert(d1.deser_int()!! == 42)
    mut d2 = d.enter_field("name")!!
    assert(d2.deser_str()!! == "gizmo")
}

test "ParamsDeserializer: enter_field on a missing key -> MissingField error" {
    mut d = ParamsDeserializer.new([("id", "42")])
    ro r = d.enter_field("missing")
    assert(match r { Err(_) => true, Ok(_) => false })
}

test "ParamsDeserializer: has_field reflects presence" {
    mut d = ParamsDeserializer.new([("id", "42")])
    assert(d.has_field("id")!! == true)
    assert(d.has_field("nope")!! == false)
}

test "ParamsDeserializer: enter_field_or_null -> null cursor for a missing key" {
    mut d = ParamsDeserializer.new([("id", "42")])
    // `mut` from the start (D246 canon (a)).
    mut sub = d.enter_field_or_null("missing")!!
    assert(sub.is_null()!! == true)
}

test "QueryDeserializer: percent-decode + '&'/'=' split, then enter_field + deser" {
    mut d = QueryDeserializer.new("q=hello%20world&limit=10")
    // `mut` from the start (D246 canon (a)).
    mut d1 = d.enter_field("q")!!
    assert(d1.deser_str()!! == "hello world")
    mut d2 = d.enter_field("limit")!!
    assert(d2.deser_int()!! == 10)
}

test "QueryDeserializer: empty query string -> no fields present" {
    mut d = QueryDeserializer.new("")
    assert(d.has_field("anything")!! == false)
}

// ── Bytes / Text / Headers : FromRequest (never fail on well-formed UTF-8) ─

test "Bytes: raw body bytes, no decode" {
    mut r = Router.new()
    r.post("/raw", fn(req ServerRequest) -> ServerResponse {
        match Bytes.from_request(req) {
            Ok(b)  => ServerResponse.text(200, "len=${b.data().len()}")
            Err(e) => e.into_response()
        }
    })!!
    ro wire = serve_once(r, post_text_req("/raw", "hello"))
    ro s = unsafe { wire.to_str_unchecked() }
    assert(s.contains("len=5"))
}

test "Text: body as UTF-8 text" {
    mut r = Router.new()
    r.post("/echo", fn(req ServerRequest) -> ServerResponse {
        match Text.from_request(req) {
            Ok(t)  => ServerResponse.text(200, "got=${t.data()}")
            Err(e) => e.into_response()
        }
    })!!
    ro wire = serve_once(r, post_text_req("/echo", "hello there"))
    ro s = unsafe { wire.to_str_unchecked() }
    assert(s.contains("got=hello there"))
}

test "Headers: exposes the request's header map" {
    mut r = Router.new()
    r.get("/hdrs", fn(req ServerRequest) -> ServerResponse {
        match Headers.from_request(req) {
            Ok(h) => match h.data().get("Host") {
                Some(_) => ServerResponse.text(200, "has-host")
                None    => ServerResponse.text(200, "no-host")
            }
            Err(e) => e.into_response()
        }
    })!!
    ro wire = serve_once(r, get_req("/hdrs"))
    ro s = unsafe { wire.to_str_unchecked() }
    assert(s.contains("has-host"))
}

// ── Ф.2b: PathParam[T] / Query[T] / Json[T] — round-trip through a real
// Router dispatch (closes 221.1 №26, [M-generic-static-method-value-arg-
// addr-mismatch]; see this file's banner) ──────────────────────────────────

// Plan 222.8 Ф.2: `Reflect` added alongside `Serialize + Deserialize` (below,
// §"typed registration") — these are the inner `T` of `PathParam[T]`/
// `Query[T]`/`Json[T]`, whose OWN `#impl(Reflect)` (extract.nv) bounds `T
// Reflect`.
#impl(Serialize + Deserialize + Reflect)
type UserIdParams value { ro id int }

#impl(Serialize + Deserialize + Reflect)
type SearchQuery value { ro q str, ro limit int }

#impl(Serialize + Deserialize + Reflect)
type CreateItem value { ro name str, ro qty int }

test "PathParam[T]: round-trip through Router dispatch" {
    mut r = Router.new()
    r.get("/users/{id}", fn(req ServerRequest) -> ServerResponse {
        match PathParam[UserIdParams].from_request(req) {
            Ok(p)  => ServerResponse.text(200, "id=${p.data().id}")
            Err(e) => e.into_response()
        }
    })!!
    ro wire = serve_once(r, get_req("/users/42"))
    ro s = unsafe { wire.to_str_unchecked() }
    assert(s.contains("id=42"))
}

test "PathParam[T]: bad int -> HttpError, not a crash" {
    mut r = Router.new()
    r.get("/users/{id}", fn(req ServerRequest) -> ServerResponse {
        match PathParam[UserIdParams].from_request(req) {
            Ok(p)  => ServerResponse.text(200, "id=${p.data().id}")
            Err(e) => e.into_response()
        }
    })!!
    ro wire = serve_once(r, get_req("/users/not-a-number"))
    assert(status_line(wire) == "HTTP/1.1 400 Bad Request")
}

test "Query[T]: round-trip through Router dispatch" {
    mut r = Router.new()
    r.get("/search", fn(req ServerRequest) -> ServerResponse {
        match Query[SearchQuery].from_request(req) {
            Ok(q)  => ServerResponse.text(200, "q=${q.data().q} limit=${q.data().limit}")
            Err(e) => e.into_response()
        }
    })!!
    ro wire = serve_once(r, get_req("/search?q=widgets&limit=10"))
    ro s = unsafe { wire.to_str_unchecked() }
    assert(s.contains("q=widgets limit=10"))
}

test "Json[T]: round-trip through Router dispatch" {
    mut r = Router.new()
    r.post("/items", fn(req ServerRequest) -> ServerResponse {
        match Json[CreateItem].from_request(req) {
            Ok(j)  => ServerResponse.text(200, "name=${j.data().name} qty=${j.data().qty}")
            Err(e) => e.into_response()
        }
    })!!
    ro wire = serve_once(r, post_json_req("/items", "{\"name\":\"gizmo\",\"qty\":5}"))
    ro s = unsafe { wire.to_str_unchecked() }
    assert(s.contains("name=gizmo qty=5"))
}

test "Json[T]: malformed body -> HttpError, not a crash" {
    mut r = Router.new()
    r.post("/items", fn(req ServerRequest) -> ServerResponse {
        match Json[CreateItem].from_request(req) {
            Ok(j)  => ServerResponse.text(200, "name=${j.data().name}")
            Err(e) => e.into_response()
        }
    })!!
    ro wire = serve_once(r, post_json_req("/items", "{not json"))
    assert(status_line(wire) == "HTTP/1.1 400 Bad Request")
}

// ── Ф.3: PathParam + Query + Json composed on ONE route (222.3 §5 gate item
// #4) — arity-overload SUGAR (`r.post[PathParam[X], Query[Y], Json[Z], R](…)`)
// is BLOCKED (see extract.nv banner, [M-concrete-instance-arity-overload-
// mangle]); this is the low-level `Handler` + manual per-extractor
// composition the banner names as the surviving registration path —
// `ServerRequest` is `value`, so all three extractors read it independently,
// no ownership conflict. Also exercises: adding a NEW route to a `Router`
// that ALSO carries plain (no-extractor) routes doesn't disturb 404/405
// (shared `Router` with the plain `/health` route below). ─────────────────

test "PathParam+Query+Json composed on one route; 404/405 unaffected on the same Router" {
    mut r = Router.new()
    r.get("/health", fn(req ServerRequest) -> ServerResponse => ServerResponse.text(200, "ok"))!!
    r.post("/items/{id}", fn(req ServerRequest) -> ServerResponse {
        match PathParam[UserIdParams].from_request(req) {
            Ok(p) => match Query[SearchQuery].from_request(req) {
                Ok(q) => match Json[CreateItem].from_request(req) {
                    Ok(j)  => ServerResponse.text(200, "id=${p.data().id} q=${q.data().q} name=${j.data().name}")
                    Err(e) => e.into_response()
                }
                Err(e) => e.into_response()
            }
            Err(e) => e.into_response()
        }
    })!!

    // happy path: all three extractors succeed
    ro wire = serve_once(r, post_json_req("/items/7?q=widgets&limit=1", "{\"name\":\"gizmo\",\"qty\":5}"))
    ro s = unsafe { wire.to_str_unchecked() }
    assert(s.contains("id=7 q=widgets name=gizmo"))

    // the plain no-extractor route on the SAME Router is unaffected
    ro wire_health = serve_once(r, get_req("/health"))
    assert(status_line(wire_health) == "HTTP/1.1 200 OK")

    // 404: no route matches at all
    ro wire_404 = serve_once(r, get_req("/nope"))
    assert(status_line(wire_404) == "HTTP/1.1 404 Not Found")

    // 405: path matches (/items/{id}) but method doesn't (only POST registered)
    ro wire_405 = serve_once(r, get_req("/items/7"))
    assert(status_line(wire_405) == "HTTP/1.1 405 Method Not Allowed")
}

// ── Plan 222.8 Ф.2: `Req` passthrough extractor, `Reflect` shapes on the
// extractor wrappers, `typed(...)` + `Router.@get_typed`/`@post_typed` +
// `Router.introspect()` ────────────────────────────────────────────────────

test "Req: passthrough FromRequest (never fails) + Opaque reflect shape" {
    mut r = Router.new()
    r.get("/whoami", fn(req ServerRequest) -> ServerResponse {
        match Req.from_request(req) {
            Ok(rq) => ServerResponse.text(200, "path=${rq.data().path()}")
            Err(e) => e.into_response()
        }
    })!!
    ro wire = serve_once(r, get_req("/whoami"))
    ro s = unsafe { wire.to_str_unchecked() }
    assert(s.contains("path=/whoami"))

    assert(match Req.reflect() { Opaque(name) => name == "ServerRequest", _ => false })
}

test "PathParam[T]/Query[T]/Json[T]: reflect shape names the wrapper type + carries the inner shape" {
    assert(match PathParam[UserIdParams].reflect() {
        Record(name, fields) => name == "PathParam" && fields.len() == 1
        _ => false
    })
    assert(match Query[SearchQuery].reflect() {
        Record(name, fields) => name == "Query" && fields.len() == 1
        _ => false
    })
    assert(match Json[CreateItem].reflect() {
        Record(name, fields) => name == "Json" && fields.len() == 1
        _ => false
    })
    // Headers/Bytes/Text stay Opaque (no schema, not in the plan's Path/
    // Query/Json role set — plan §1.3 "Req/Headers/Opaque → пропускается").
    assert(match Headers.reflect() { Opaque(_) => true, _ => false })
    assert(match Bytes.reflect()   { Opaque(_) => true, _ => false })
    assert(match Text.reflect()    { Opaque(_) => true, _ => false })
}

// NOTE (compiler-bug marker candidates): a generic `typed(handler_fn)`
// wrapper that DECODES via `T.from_request`/calls the caller's handler
// fn/ENCODES via `R`'s `IntoResponse` — the plan's original single-wrapper
// design — still does not codegen: `[M-generic-fn-value-param-call-mono-
// collision]` (registry backlog №140, OPEN, see extract.nv's comment above
// `TypedRoute` for the full diagnosis) — calling a GENERIC fn-VALUE
// parameter from inside a generic function cross-contaminates an unrelated
// same-CU closure's call signature. `TypedRoute` stays built as a direct
// struct literal for that reason (registration surface below).
//
// SEPARATELY, the plan §1.3 CANON bundle shape (`type GetUserReq { id
// PathParam[UserId], filter Query[Filter], .. }` — a record whose FIELDS
// are extractor-wrapper generic instantiations) is now UNBLOCKED:
// `[M-user-generic-value-type-as-struct-field]` (registry №139) CLOSED
// 2026-07-27 (`58ef14363`, 4 rounds — unified topo-sorted value-type
// section in emit_c). `GetItemBundle` below IS that canon shape (`T` =
// a multi-field bundle, not a single extractor wrapper) — the test after
// it is the real end-to-end proof the fix was for.

// Plan 222.8 §1.3 canon bundle: SEVERAL different extractor-wrapper fields
// on ONE record (`PathParam[T]`/`Query[T]`/`Json[T]`/`Req` side by side) —
// the exact shape №139 blocked. Field order = extraction order in
// `from_request` below (plan §1.3: "первый Err короткозамыкает").
#impl(Reflect)
type GetItemBundle {
    id      PathParam[UserIdParams],
    filter  Query[SearchQuery],
    payload Json[CreateItem],
    raw     Req,
}

/// Hand-composed `FromRequest` (plan §1.3 — NOT derived, `FromRequest`
/// belongs to polaris, not the compiler): each field's own extractor does
/// the real decode, `?` short-circuits the first `Err` before the handler
/// ever runs.
#impl(FromRequest)
fn GetItemBundle.from_request(req ServerRequest) -> Result[GetItemBundle, HttpError] {
    ro id      = PathParam[UserIdParams].from_request(req)?
    ro filter  = Query[SearchQuery].from_request(req)?
    ro payload = Json[CreateItem].from_request(req)?
    ro raw     = Req.from_request(req)?
    Ok(GetItemBundle { id, filter, payload, raw })
}

test "GetItemBundle (canon multi-extractor bundle, №139 closed) + Router.@post_typed: end-to-end decode/encode, introspect() reports the bundle's OWN fields" {
    mut r = Router.new()
    // A plain no-extractor route on the SAME router — introspect() must
    // report it too, honestly `None`/`None` (plan §1.3: raw `Handler` ->
    // "schema unknown", not guessed).
    r.get("/health", fn(req ServerRequest) -> ServerResponse => ServerResponse.text(200, "ok"))!!
    r.post_typed("/items/{id}", TypedRoute{
        handler: fn(req ServerRequest) -> ServerResponse {
            match GetItemBundle.from_request(req) {
                Ok(b) => ServerResponse.text(200, "id=${b.id.data().id} q=${b.filter.data().q} limit=${b.filter.data().limit} name=${b.payload.data().name} qty=${b.payload.data().qty} path=${b.raw.data().path()}")
                Err(e) => e.into_response()
            }
        },
        req_shape: Some(GetItemBundle.reflect()),
        resp_shape: Some(str.reflect()),
    })!!

    // happy path: ALL FOUR bundle fields (PathParam+Query+Json+Req)
    // extracted correctly from ONE request, in ONE handler call — this is
    // the case №139 blocked end-to-end (registration → request → handler
    // sees every field).
    ro wire = serve_once(r, post_json_req("/items/7?q=widgets&limit=10", "{\"name\":\"gizmo\",\"qty\":5}"))
    ro s = unsafe { wire.to_str_unchecked() }
    assert(status_line(wire) == "HTTP/1.1 200 OK")
    assert(s.contains("id=7"))
    assert(s.contains("q=widgets"))
    assert(s.contains("limit=10"))
    assert(s.contains("name=gizmo"))
    assert(s.contains("qty=5"))
    assert(s.contains("path=/items/7"))

    // a bad path param short-circuits on the FIRST `?` (PathParam) — Query/
    // Json/Req never run, proving the composition order in `from_request`.
    ro wire_bad = serve_once(r, post_json_req("/items/not-a-number?q=x&limit=1", "{\"name\":\"n\",\"qty\":1}"))
    assert(status_line(wire_bad) == "HTTP/1.1 400 Bad Request")

    // introspect(): the bundle's OWN field names/roles surface as a
    // Record("GetItemBundle", [4 fields]) — not a single flat wrapper name
    // (the pre-№139 single-extractor limitation this test replaces).
    ro routes = r.introspect()
    mut saw_bundle = false
    mut saw_plain = false
    for info in routes {
        if info.path == "/items/{id}" && info.method == "POST" {
            saw_bundle = true
            assert(match info.req_shape {
                Some(shape) => match shape {
                    Record(name, fields) => name == "GetItemBundle" && fields.len() == 4
                    _ => false
                }
                None => false
            })
        }
        if info.path == "/health" && info.method == "GET" {
            saw_plain = true
            assert(info.req_shape.is_none())
            assert(info.resp_shape.is_none())
        }
    }
    assert(saw_bundle)
    assert(saw_plain)
}
