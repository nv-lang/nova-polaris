// SPDX-License-Identifier: MIT OR Apache-2.0
// nova-http: serve.nv — the reusable library accept-loop + persistent
// (keep-alive) per-connection driver `[M-178-server-policy-surface]`
// (owner decision 2026-07-22: закрыть сейчас).
//
// This is the "serve(listener, handler)" the file-header of `servernet.nv`
// itself flagged as missing (the flagship aggregator's own `main.nv` hand-
// rolls its accept loop today for exactly that reason — see that file's
// own `[M-187-nested-spawn-scope-var-cc-fail]`/
// `[M-187-high-concurrency-connection-wedge]` notes, which this module
// reuses the PROVEN shapes from: one `spawn` owns bind + the whole accept
// loop, `detach consume stream { ... }` per accepted connection, a
// `Semaphore` admission gate). `handle_connection` (`servernet.nv`,
// single-shot `Connection: close`) is UNCHANGED — this is a new, additive
// entry point; existing callers (the flagship aggregator, this package's
// own `rt/*_smoke.nv` tests) keep working exactly as before.
//
// Deliverable 1 (accept-loop hardening): `serve()`'s own `Err(_) => { ...
// back off; keep looping ... }` arm is the direct fix for the documented bug
// (`main.nv`'s current `Err(_) => { running = false }` — a transient accept
// error kills the WHOLE server). Admission control is the same shape as the
// aggregator's own mitigation (`[M-187-high-concurrency-connection-wedge]`)
// generalized into this package as a policy KNOB (`ServerPolicy.
// max_inflight`/`reject_with_503`) instead of a hardcoded app-level constant.
//
// ADMISSION GATE = `Semaphore.try_acquire() -> Option[Permit]` (owner
// decision 2026-07-23, migrated same-day once the primitive landed —
// `std/runtime/sync.nv`'s own doc-comment names "connection pool capacity"
// as `Semaphore`'s canonical use case). WHY NOT a bare `AtomicInt` counter:
// a handler panic unwinds the connection-handling fiber via `longjmp` — a
// bare `ro _ = inflight.fetch_sub(1)` statement placed AFTER the panicking
// call is simply never reached (longjmp jumps PAST it, no unwind-time hook
// fires for an ordinary sequential statement) — the admission slot leaks
// forever. `Some(consume p) => { consume p { ... } }` fixes this properly:
// `p` (the `Permit`) lives in the CONNECTION's own scope and its `@cleanup`
// fires on scope-exit — success, error, OR panic (D432) — releasing the
// slot every time, no `defer`/bare-`release()` pairing needed at all
// (superseding this file's EARLIER `defer sem.release()`-based attempt,
// which itself had to route around a SEPARATE codegen defect — see
// `release_after`'s own git-history note, now removed along with it).
// `try_acquire()` itself is non-blocking (`None` immediately on
// exhaustion, per its own doc-comment "designed for admission control:
// take slot or reject immediately") — exactly the non-parking semantics
// admission needs; the retired bool+manual-`release()` door is gone for good
// (R3 D325 rename 2026-07-26: `try_acquire_permit` -> `try_acquire`).
//
// LAYER CONTRACT (Plan 222 §0а, refit 2026-07-23): same as `servernet.nv`'s
// own note — `serve`/`serve_connection` take a byte-level callback
// (`fn([]u8) -> ServerResponse`), NOT a `Router` — this module never imports
// `Router`/`route_once` (layer 2). `server/server_serve.nv`'s `serve_router`
// is the `Router`-taking convenience wrapper.

module polaris.net

import std.net.{TcpListener, TcpStream, NetError}
import std.runtime.sync.{Semaphore, AtomicInt}
import std.time.duration
import polaris.{ServerResponse, serialize_response, Log}
import polaris.{serialize_response_head, encode_chunk, encode_chunk_end}

// ── Anti-flood aggregation for the admission-reject log line (222.22 Ф.1
//    decision: "первый отказ сразу, дальше не чаще раза в 5s сводкой K за
//    N сек" — a connection-flood must not become a log-flood). `count`/
//    `window_start_ms` are `AtomicInt` cells (`#share`, same recipe
//    `middleware/log.nv`'s `@middleware()`-closure counter uses since
//    [№354]) — `RejectLog` is a private (non-`#stable`) internal `value`
//    record, so mixing runtime-counter fields into it does not carry the
//    rule-38 public-API concern `AccessLog` had; every copy (one per
//    `detach`-ed connection, same shape as `inflight`/`policy` below)
//    aliases the SAME two cells via direct `@count`/`@window_start_ms`
//    method calls — no local copy needed, `@record()`'s own field access
//    IS the mut root ([№355], same as `middleware/ratelimit.nv`'s
//    `@bucket_for` calling `@mutex.lock()` directly). ─────────────────────

const REJECT_LOG_WINDOW_MS int = 5000

type RejectLog value priv {
    count           AtomicInt
    window_start_ms AtomicInt
}

fn RejectLog.new() -> RejectLog => { count: AtomicInt.new(0), window_start_ms: AtomicInt.new(0) }

// Record one admission-reject. The FIRST reject (ever, or the first after a
// window flush) logs immediately; later rejects inside the same
// `REJECT_LOG_WINDOW_MS` window only increment the counter. Once the window
// has elapsed, the NEXT reject to observe that (a single-winner
// `compare_exchange` on `window_start_ms` — best-effort, not exact: under
// contention two rejects landing at the same instant could each see the
// stale window and only one wins the CAS, same ±1 tolerance
// `middleware/ratelimit.nv`'s own token bucket documents for its unlocked
// table) flushes a summary line and starts a fresh window.
fn RejectLog @record() Time {
    ro now_ns = Monotonic.now().nanos() as int
    ro n = @count.fetch_add(1) + 1
    if n == 1 {
        @window_start_ms.store(now_ns)
        // Admission-503/anti-flood (owner decision 2026-08-01,
        // `[M-log-levels-standard-plus-threshold]`): a rejected connection
        // is a client-visible 503 + Retry-After, not an operator emergency —
        // `warn`, not `error` (kept for panics/crashes only).
        Log.warn("rejected connection: max_inflight admission limit reached")
    } else {
        ro started_ns = @window_start_ms.load()
        ro elapsed_ms = (now_ns - started_ns) / 1_000_000
        if elapsed_ms >= REJECT_LOG_WINDOW_MS {
            match @window_start_ms.compare_exchange(started_ns, now_ns) {
                Ok(_) => {
                    ro flushed = @count.swap(0)
                    Log.warn("rejected ${flushed} in last ${elapsed_ms}ms")
                }
                Err(_) => ()
            }
        }
    }
}

// ── ws-hijack + recover-500: run one request's handler UNDER Stop-
//    supervision, INSIDE the write (Plan 222 final-plumbing tasks 1+2,
//    `[M-ws-on_upgrade-hijack-not-wired]` + `[M-servemux-recover-500]`) ────
//
// Composition, no new runtime primitive for the recover-500 half: SAME
// Stop-supervision shape as `BackgroundTasks.@drain()` (server/background.nv,
// D416) — a `supervised { spawn { ... } }` scope with a custom `Supervisor`
// handler whose `on_child_fail` returns `Decision.Stop` (the failure is
// contained, does NOT propagate, does NOT crash the process).
//
// WHY THE HANDLER CALL + UPGRADE CHECK + WIRE WRITE ALL HAPPEN **INSIDE**
// THE SPAWN (not: run the handler in a spawn, bring the `ServerResponse`
// back out, THEN decide/write) — found empirically while wiring this:
// `ServerResponse` embeds THREE closure-bearing `Option[...]` fields
// (`stream: Option[StreamBody]`, `background: Option[BackgroundTasks]`,
// `upgrade: Option[fn(TcpStream) Net -> ()]`) — the M:N share-ness checker
// cannot prove ANY of them safe to alias across a spawned-fiber boundary via
// a captured `mut` outer variable (`[E_CONCURRENT_MUT_CAPTURE] ...
// ServerResponse is poisoned at ServerResponse.stream::Some.0 (T): an
// unresolved type name T` — reproduces identically whether captured as
// `Option[ServerResponse]` or bare `ServerResponse`; a `Channel[ServerResponse]`
// fails EARLIER still, at codegen — `E_CHANNEL_UNSOUND_ELEM_TYPE`,
// `ServerResponse`'s C struct isn't pointer-sized, `Channel[T]`'s runtime
// backing is a single `nova_int`-sized slot, `nova_rt/channels.h`). A
// payload-less enum (`ConnStep` below) WITH an explicit type annotation on
// the captured local DOES cross the boundary safely (probed in isolation:
// `mut step ConnStep = ConnStep.StepX` inside a nested `supervised { spawn
// consume shs = s.share() { step = ... } }` — no annotation → a SEPARATE
// `E_CONCURRENT_MUT_CAPTURE` variant, "type is unknown at the capture site",
// since the checker's syntactic type-sketch pass doesn't recognize a bare
// enum-variant constructor `Step.A` as a `Named{Type}` ctor pattern the way
// it does `Type.new(...)`/literals — WITH the annotation, both variants
// disappear). So: `resp` is produced and consumed by the SAME fiber (never
// crosses out), and only the outcome DISCRIMINATOR crosses back — same
// `s.share()` cross-fiber-lend recipe `policy.nv`'s own `read_attempt`
// already proves for a plain read. Both gaps: report to integrator for
// `docs/plans/backlog-followups.md` (this worktree does not touch the nova
// repo).
//
// D437 caveat (owner-requested normative anchor, spec/decisions/08-runtime.md):
// the runtime's own uncaught-panic diagnostic is "message + throw-site +
// propagation trace" — but that full format is ONLY ever printed by the
// runtime's own top-level unhandled-abort path
// (`nova_throw_site_dump`/`effects.h`); there is NO Nova-level accessor that
// exposes the throw-site/trace to a `Supervisor.on_child_fail` handler (`err
// any` only yields the message via `.try_as[str]()`, confirmed against
// `effects.h`/`fibers.h`'s own C source — `nova_throw_site_set`/
// `_nova_throw_site` are C-internal, no extern binding anywhere in `std/`).
// `BackgroundTasks.@drain()` hits the exact same wall and logs message-only
// — this fn does the same, honestly, rather than fabricate a "site".
type ConnStep enum
    | StepKeepAlive // wrote OK, both sides agreed to continue the connection
    | StepClose     // wrote OK (or nothing to write), connection ends here
    | StepCloseErr  // a write failed — connection ends here, propagate NetError

// Read+dispatch already happened (`read_one_request`, caller) — this runs
// `handler(raw)` UNDER Stop-supervision, checks the result for a ws-hijack
// (`@take_upgrade()`), and writes the response, ALL inside the same spawned
// fiber (see banner above for why). On a caught panic/throw, logs
// `"handler panic: <message>"` via the ambient `Log` effect (`Log.error`,
// raw op — Plan 222.20 Ф.3 Волна A §Q3, `log.nv`; this fn's own row stays
// `Net Time`, unchanged — design note §0 Ф-C: a raw op is not checked under
// `--strict-effects`) and answers per `policy.panic_response()`:
// `InternalError500` -> writes a 500 (in THIS, the un-panicked caller fiber —
// the spawn already exited), `Close` -> writes nothing.
fn run_request(mut s TcpStream, handler fn([]u8) -> ServerResponse, raw []u8, policy ServerPolicy, keep_alive bool) Net Time -> ConnStep {
    // №173: былое обоснование «legal per D416§2 serialization» ОПРОВЕРГНУТО
    // перезамером (5/10 падений пин-фикстуры) — carve-out отозван, флаг и
    // текст идут через синхронизированные типы (белый список D441).
    mut failed = AtomicBool.new(false)
    mut step ConnStep = ConnStep.StepCloseErr
    with Supervisor = effect Supervisor {
        on_child_fail(idx int, err any) -> Decision {
            // №173: лог в момент падения, в файбере ребёнка; наружу — только
            // атомарный флаг для panic_response-ветки.
            failed.store(true)
            if Some(msg) = err.try_as[str]() {
                Log.error("handler panic: ${msg}")
            } else {
                Log.error("handler panic: non-string handler error")
            }
            return Decision.Stop
        }
    } {
        supervised {
            spawn consume shs = s.share() {
                mut resp = handler(raw)
                // [M-serve-router-background-tasks-not-drained] (P1, owner
                // decision 2026-08-01): `resp.take_background()` BEFORE the
                // `take_upgrade()` branch below — `run_background(bg)` then
                // runs on the SUCCESS arm of each branch's own write, mirror
                // of `servernet.handle_connection`'s `run_background(bg)`
                // (this driver's own gap: it never called this at all,
                // so `BackgroundTasks` queued through `serve_router`'s
                // keep-alive path never ran).
                ro bg = resp.take_background()
                match resp.take_upgrade() {
                    // ws-hijack (task 1): write the 101 bytes, then hand the
                    // LIVE (shared) socket to the hook instead of the normal
                    // keep-alive continuation/close. `hook(shs)` moves `shs`
                    // for good (`TcpStream` has its own `@cleanup`, D188 — no
                    // double-close risk; `s`, the ORIGINAL, is untouched here
                    // and still gets its own `@close()` from the caller's
                    // trailing cleanup — rc-aware, so that is a harmless
                    // decrement, not a real double-close, per `TcpStream.
                    // @share()`'s own doc-comment). `supervised { spawn { ... }
                    // }` (not `detach`) BLOCKS until `hook` returns — exactly
                    // right: `run_request`/`serve_connection` legitimately
                    // don't have anything else to do with this connection
                    // until the whole WebSocket session ends (fiber-per-
                    // connection model, same as every other blocking `Net`
                    // call already in this driver).
                    Some(hook) => {
                        resp.header("Connection", "Upgrade")
                        match write_response_keepalive(shs, resp) {
                            Ok(_)  => { run_background(bg); hook(shs); step = ConnStep.StepClose }
                            Err(_) => { step = ConnStep.StepCloseErr }
                        }
                    }
                    None => {
                        resp.header("Connection", if keep_alive { "keep-alive" } else { "close" })
                        match write_response_keepalive(shs, resp) {
                            Ok(_)  => { run_background(bg); step = if keep_alive { ConnStep.StepKeepAlive } else { ConnStep.StepClose } }
                            Err(_) => { step = ConnStep.StepCloseErr }
                        }
                    }
                }
            }
        }
    }
    if failed.load() {
        match policy.panic_response() {
            // `InternalError500`: the panic was cleanly caught BEFORE any
            // response bytes went out (the whole handler call + write
            // happens inside the SAME Stop-supervised spawn above, so a
            // panic mid-handler never left a partial/corrupted response on
            // the wire) — a well-formed `500` is exactly as safe to keep the
            // connection alive after as any other response, so this honors
            // the SAME `keep_alive` decision (`read_one_request`/
            // `should_keep_alive`, policy.nv) every other response does: the
            // server stays up AND, if both sides agreed to keep-alive, this
            // SAME connection goes on to serve the next request (recover-500
            // task 2's own acceptance shape — "connection stays alive for
            // the NEXT request", not just "a NEW connection can still be
            // admitted").
            HandlerPanicResponse.InternalError500 => {
                mut resp500 = ServerResponse.text(500, "500 internal server error")
                resp500.header("Connection", if keep_alive { "keep-alive" } else { "close" })
                ro _ = write_response_keepalive(s, resp500)
                if keep_alive { ConnStep.StepKeepAlive } else { ConnStep.StepClose }
            }
            HandlerPanicResponse.Close => ConnStep.StepClose
        }
    } else {
        step
    }
}

// `run_background` (drain queued `BackgroundTasks`, if any) is NOT
// redefined here — `servernet.nv` (this SAME folder-module, `module
// polaris.net`) already has it (used by `handle_connection`), and a
// folder-module's peer files share private scope (D78/module-folder
// model), so it is directly visible/callable from here too. Defining a
// second copy in this file is a hard compile error (`duplicate definition
// run_background with same signature`, D84) — found empirically wiring
// `[M-serve-router-background-tasks-not-drained]`.

// ── Non-consuming response write (keep-alive: the stream survives to serve
//    the NEXT request on success) — mirrors `handle_connection`'s own
//    fixed/streaming split (`write_streaming`/`write_stream_chunks`), but
//    those two take `consume` and unconditionally `@close()` the stream
//    (correct for the single-shot handler, wrong here). ────────────────────

fn write_response_keepalive(mut s TcpStream, resp ServerResponse) Net -> Result[(), NetError] {
    if resp.is_streaming() {
        write_streaming_keepalive(s, resp)
    } else {
        s.write_all(serialize_response(resp))
    }
}

fn write_streaming_keepalive(mut s TcpStream, resp ServerResponse) Net -> Result[(), NetError] {
    match s.write_all(serialize_response_head(resp)) {
        Ok(_)  => write_stream_chunks_keepalive(s, resp)
        Err(e) => Err(e)
    }
}

fn write_stream_chunks_keepalive(mut s TcpStream, resp ServerResponse) Net -> Result[(), NetError] {
    match resp.take_stream() {
        None => Ok(())   // unreachable: caller checked @is_streaming()
        Some(mut producer) => {
            mut running = true
            mut result Result[(), NetError] = Ok(())
            while running {
                match producer.next_chunk() {
                    Some(chunk) => {
                        match s.write_all(encode_chunk(chunk)) {
                            Ok(_)  => ()
                            Err(e) => { result = Err(e); running = false }
                        }
                    }
                    None => {
                        match s.write_all(encode_chunk_end()) {
                            Ok(_)  => ()
                            Err(e) => { result = Err(e) }
                        }
                        running = false
                    }
                }
            }
            result
        }
    }
}

// ── serve_connection: persistent (keep-alive) per-connection driver ───────
//
// Replaces `handle_connection`'s single-shot "read one, respond, close"
// with a loop: read a GOVERNED request (`read_one_request`, `policy.nv` —
// deadlines/body-cap/chunked-decode already applied), dispatch it through
// `handler` (byte-level callback — see this file's own layer-contract note;
// `server/server_serve.nv`'s `serve_router` is the `Router`-taking
// convenience wrapper most callers actually want), force the wire
// `Connection` header to match the keep-alive decision (the pure-core
// serializer defaults to `close` whenever the response doesn't already set
// one — `server/wire.nv` `serialize_response`/`serialize_response_head` —
// so an explicit override here is what actually MAKES keep-alive happen on
// the wire, no server.nv change needed), write it, and loop again if both
// sides agreed to continue. `served_count` is the loop's own counter
// (starts at 0, passed to `read_one_request` so `should_keep_alive` can
// enforce `max_requests_per_conn`).
#stable(since = "0.1")
export fn serve_connection(consume stream TcpStream, handler fn([]u8) -> ServerResponse, policy ServerPolicy) Net Time -> Result[(), NetError] {
    mut served_count = 0
    mut keep_going = true
    mut final_result Result[(), NetError] = Ok(())
    while keep_going {
        match read_one_request(stream, policy, served_count) {
            Ready(raw, keep_alive) => {
                served_count += 1
                // ws-hijack (task 1) + recover-500 (task 2): `run_request`
                // (above) runs `handler(raw)` under Stop-supervision, checks
                // `@take_upgrade()`, and writes the response — ALL inside its
                // own spawned fiber (see that fn's own banner for why the
                // response value never crosses back out here, only the
                // `ConnStep` discriminator does).
                match run_request(stream, handler, raw, policy, keep_alive) {
                    StepKeepAlive => { keep_going = true }
                    StepClose     => { keep_going = false }
                    StepCloseErr  => { keep_going = false; final_result = Err(NetError.Closed) }
                }
            }
            EarlyResponse(mut resp) => {
                resp.header("Connection", "close")
                ro _ = write_response_keepalive(stream, resp)
                keep_going = false
            }
            ConnectionDone => {
                keep_going = false
            }
        }
    }
    // #672 form (1) (nova registry 221.1, owner's ruling 2026-08-21): this
    // function takes the connection by `consume`, so this function closes it.
    // It used to just fall off the end. D432 auto-`@cleanup` looked like it
    // covered that, and does not: the codegen arms a cleanup only for a bare
    // `consume X = e` binding with an ident pattern, never for a consume
    // PARAMETER -- so the caller disarmed its own flag when it handed the
    // socket over and the callee released nothing. The single-shot sibling
    // `handle_connection` (servernet.nv:74) has always closed on both paths;
    // this keep-alive replacement simply forgot to. `run_request`'s ws-hijack
    // branch already ASSUMES this close exists ("still gets its own
    // `@close()` from the caller's trailing cleanup -- rc-aware, so that is a
    // harmless decrement"): the `@share()` copy handed to the hook holds its
    // own rc unit, so this is a decrement, not a double close.
    stream.close()
    final_result
}

// ── serve: the reusable library accept loop ────────────────────────────────
//
// Shape mirrors the flagship aggregator's own `main()` accept loop (proven
// against two documented codegen/runtime failure modes — see this file's
// own header): exactly ONE `spawn` holds bind + the whole loop; each
// accepted connection is handed to `detach consume stream { ... }`
// (bounded-concurrent, not sequential); a `Semaphore.try_acquire_permit()`
// (see this file's own header — panic-safe via the returned `Permit`'s own
// `@cleanup`, NOT a bare counter) is the admission gate. Two hardening
// fixes over that hand-rolled original (deliverable 1):
//   - `Err(_)` from `accept()` no longer kills the loop — it backs off
//     briefly and continues (a transient accept error, e.g. the OS FD table
//     momentarily full, should not take the whole server down);
//   - the admission-reject path now optionally answers with a real `503`
//     (`policy.reject_with_503()`) instead of always just closing — a
//     friendlier, retry-safe signal to a well-behaved client.
//
// The admission CHECK (`inflight.try_acquire()`) runs INSIDE the
// `detach { }` body, not before it — `detach consume c { ... }` only names
// ONE explicit linear capture (D415 §4: "requires a block body — the
// orphan fiber owns `c`"; no multi-name form, confirmed empirically), and
// BOTH `stream` (`TcpStream consume`) and the `Permit` a successful
// admission produces are linear values that need to cross into the SAME
// orphan fiber. Obtaining the `Permit` fresh INSIDE the already-`detach`ed
// body (rather than in the outer accept loop, then somehow moving TWO
// linear values across the fiber boundary at once) sidesteps that
// single-capture limit entirely — `p` never crosses a fiber boundary, it is
// created and consumed by the SAME fiber throughout. Functionally
// equivalent to a pre-detach check (same accept/reject responses over the
// wire); the only difference is a rejected connection's own tiny `detach`
// still gets spawned before it rejects — negligible cost for a bool check
// + immediate close, not the "unbounded nested work" class of concern
// `[M-187-high-concurrency-connection-wedge]` was actually about.
// Graceful shutdown (222.22 финал, A-V9 window, 2026-08-01) — ATTEMPTED
// AGAIN, BLOCKED AGAIN, by THREE further compiler defects (all distinct
// from each other and from the ORIGINAL one below, which IS confirmed
// fixed — see end of this note). `TcpListener.accept()`'s own doc-comment
// (`std/net/tcp.nv`) calls it "parks; cancel-safe", so the intended shape
// was `stop CancelToken` (a required 4th param — an `Option[...] = None`
// default was tried FIRST and independently blocked, see defect 2 below),
// `supervised(cancel: stop) { while running { match listener.accept()
// { ... Err(e) => match e { NetError.Cancelled => running = false, _ => ...
// } } } }` plus a bounded post-loop drain polling `inflight.
// available_permits()` against a `graceful_drain` deadline (`ServerPolicy`,
// `config.nv` — NOT added back, since the feature it was for stayed
// blocked). Three defects hit, each with a minimal std-only repro (no
// `ServerPolicy`/sockets/`Router` needed for any of them):
//
// 1. A `mut` local captured into a `detach { }` body placed inside a
//    `while` loop, read again AFTER that loop ends, in the SAME function —
//    fails C-codegen with `error: use of undeclared identifier
//    '_nova_detach_0_box_<name>'`:
//    ```
//    fn probe() Detach {
//        mut inflight = Semaphore.new(4)
//        mut running = true
//        while running {
//            detach { ro _ = inflight.try_acquire() }
//            running = false
//        }
//        ro avail = inflight.available_permits()   // <- breaks codegen
//        println("avail=${avail}")
//    }
//    ```
//    WORKAROUND FOUND: move the `while { detach { ... } }` loop into its
//    OWN function, taking the captured variable as a plain `mut` PARAMETER
//    (a `Semaphore` is an opaque reference-counted handle, so the same
//    object is mutated either side of the call) — the post-loop read then
//    lives in a DIFFERENT function body than the `detach`, and compiles
//    clean. Reported for the integrator regardless — the workaround should
//    not be necessary.
//
// 2. A function taking a multi-field `value`-record parameter (passed by
//    pointer at the C ABI level, e.g. `ServerPolicy`) FOLLOWED by a
//    parameter with a DEFAULT VALUE, called from ANOTHER function that
//    passes the value-record through, fails C-codegen with `error:
//    indirection requires pointer operand ('NovaValue_<Type>' invalid)` AT
//    THE CALL SITE — regardless of whether the caller passes the optional
//    arg explicitly or omits it (so this is not about default-injection
//    specifically; it is about a default being DECLARED on the callee's
//    parameter at all):
//    ```
//    type Foo value { a int, b int, c int }
//    fn Foo.new() -> Foo => { a: 1, b: 2, c: 3 }
//    fn callee(f Foo, stop Option[int] = None) -> int {
//        match stop { Some(v) => f.a + v, None => f.a }
//    }
//    fn caller(f Foo) -> int { callee(f) }             // <- breaks codegen
//    fn main() Detach -> () { println("${caller(Foo.new())}") }
//    ```
//    The exact same shape with NO default (`stop Option[int]` required, no
//    `= None`) compiles clean. WORKAROUND: make the parameter required, not
//    defaulted (forces every call site to pass it explicitly — no
//    `serve_router`/`serve_addr` sugar-layer signature stayed 3-arg by
//    synthesizing a fresh, nobody-holds-it `CancelToken.new()` internally).
//
// 3. Even with (1) and (2) worked around, the resulting `stop CancelToken`
//    was FUNCTIONALLY inert: `supervised(cancel: tok) { ... listener.
//    accept() ... }` with `accept()` called DIRECTLY in the supervised
//    block's own body (no inner `spawn`) NEVER actually gets interrupted by
//    `tok.cancel(...)` — confirmed empirically (a 15s test timeout elapsed
//    with the accept loop still parked). Wrapping the SAME `accept()` call
//    in an inner `spawn { ... }` (child of the `supervised(cancel:)` scope)
//    DOES get interrupted promptly — matches the established pattern this
//    package's OWN `policy.nv` (`read_attempt`) and `std/concurrency/
//    cancellation.nv` (`race2`) already use (every proven-working
//    cancellable op in this codebase runs inside a `spawn`, never directly
//    in the supervised block's own top-level body). But: moving `listener`
//    (this fn's own `consume TcpListener` PARAMETER) into that inner
//    `spawn consume listener { ... }` hits a FOURTH defect —
//    `error: use of undeclared identifier '_defer_N_0_active'` (comment in
//    the generated C: "Plan 217: consume-param call-arg — cleanup
//    дизармлен"):
//    ```
//    fn accept_loop(consume listener TcpListener, cancel_tok CancelToken) Net Time Detach {
//        supervised(cancel: cancel_tok) {
//            spawn consume listener {              // <- breaks codegen
//                match listener.accept() { ... }
//            }
//        }
//    }
//    ```
//    A `TcpListener` bound FRESH INSIDE the spawn (not received as an
//    already-consumed parameter — `consume lst = TcpListener.bind(...)`
//    written directly in the spawn body) does NOT hit this — but `serve()`'s
//    whole established API takes an ALREADY-bound listener as a parameter
//    (every caller — `serve_router`, every example/test — reads
//    `local_port()` before serving), so this workaround is not available
//    without a bigger, riskier API redesign out of this task's scope.
//    Compounded with defect 1 (the post-loop drain read also needs
//    `inflight` to survive past whatever function holds the `detach`), no
//    combination tried lands a REAL, interrupt-capable accept loop. All
//    three reported for the integrator; none fixed in this package.
//
// The ORIGINAL blocker (a `CancelToken` reachable ANYWHERE in a fn whose
// body ALSO has this `detach consume stream { match inflight.try_acquire()
// { ... } }` multi-capture shape, `error: use of undeclared identifier
// '_nova_detach_0_box_inflight'` — same error text as defect 1 above, but a
// DIFFERENT trigger: CancelToken-reachability alone, no post-loop read
// needed) IS confirmed FIXED on the current compiler — verified in
// isolation, with and without a `supervised(cancel:)` wrapper, no drain
// code.
//
// RESOLVED 2026-08-29: all four numbered defects above were re-measured
// with the reproducers from this very banner, and NONE reproduces on the
// current compiler. The knob was then added in the shape defect 2 had
// ruled out — `stop Option[CancelToken] = None`, keyword-only per D102 —
// so `#stable` holds and every existing call site compiles untouched.
// One NEW defect was found while doing it (registry #790): reading a
// detach-boxed mut local after a `supervised(cancel:)` block whose park
// was a real uv `accept()` dies with an access violation in the fiber
// arena (a TIMER park in the same shape is fine, which is why every probe
// with `sleep()` passed). It was worked around structurally for a few
// hours -- the accept loop was moved into its own `serve_accept_loop`, so
// `serve()`'s own body held no detach capture. Proven then by
// `rt/serve_graceful_shutdown_smoke.nv` (live socket, cancel at 300ms,
// asserts serve() RETURNED) and the full src/net+src/rt run: PASS 11
// FAIL 0.
//
// THE WORKAROUND IS GONE, 2026-08-29 the same day: #790 is fixed in the
// compiler (nova 3cf9d6aa0, on main as 8d01c8370 -- the lazily allocated
// detach box is NULL-guarded at reads emitted after the detach site, where
// it could still be NULL because the site may never run). The loop is
// inline in `serve()` again and `serve_accept_loop` no longer exists; the
// drain's post-loop `available_permits()` is once more a boxed read after
// a uv-cancelled block, which is exactly the shape that used to crash.
// Both smokes PASS on this merged shape.

#stable(since = "0.1")
export fn serve(consume listener TcpListener, handler fn([]u8) -> ServerResponse, policy ServerPolicy, stop Option[CancelToken] = None) Net Time Detach {
    mut inflight = Semaphore.new(policy.max_inflight())
    mut reject_log = RejectLog.new()
    // A caller that passed no token still gets the same code path: a fresh
    // token nobody holds simply never fires, so `serve()` loops forever as
    // it always did. One shape, not two.
    ro cancel_tok = match stop {
        Some(tok) => tok
        None => CancelToken.new()
    }
    // Explicit re-binding: with a defaulted parameter in the signature the
    // checker loses track of consumption THROUGH the helper call and reports
    // D133 'consumed on part of paths'; a bare consume-binding makes the
    // transfer visible on every path.
    consume lst = listener
    // #790 FIXED (nova 3cf9d6aa0, 2026-08-29): the accept loop lives inline
    // again. It was split into serve_accept_loop() as a structural workaround
    // while reading a detach-boxed local after a uv-cancelled supervised
    // block crashed; the compiler now NULL-guards the lazy box, proven by
    // spec_tests standalone/m790_detach_box_unexecuted_site.nv and this
    // file's own smokes.
    supervised(cancel: cancel_tok) {
    mut running = true
    while running {
        match lst.accept() {
            Ok(consume stream) => {
                detach consume stream {
                    match inflight.try_acquire() {
                        // `p` (the Permit) is bound by a MATCH ARM PATTERN, and
                        // D432 auto-cleanup does NOT cover those: it covers bare
                        // `consume X = e;` bindings only (D432 section 2 --
                        // destructuring patterns stay under plain D133), and the
                        // codegen emits no cleanup for a pattern binding at all.
                        // The comment that used to stand here claimed the
                        // opposite, and the slot was never returned: after
                        // `max_inflight` connections the semaphore was empty
                        // forever and the server stopped serving. Found by the
                        // checker fix of nova registry #667 (2026-08-15), which
                        // turned that silence into an honest D133-not-consumed.
                        // Release explicitly, on every path out of the arm.
                        Some(consume p) => {
                            ro _ = serve_connection(stream, handler, policy)
                            p.release()
                        }
                        None => {
                            reject_log.record()
                            if policy.reject_with_503() {
                                ro _ = stream.write_all("HTTP/1.1 503 Service Unavailable\r\nRetry-After: 1\r\nConnection: close\r\nContent-Length: 0\r\n\r\n")
                            }
                        }
                    }
                }
            }
            Err(e) => {
                // Cancellation is not a transient error: it is the shutdown
                // signal arriving through `accept()`, which its own doc-comment
                // calls "parks; cancel-safe". Anything else is transient —
                // back off briefly and KEEP LOOPING (do not exit), the shape
                // already proven by this codebase's reconnect/backoff sites;
                // no unbounded busy-loop.
                match e {
                    NetError.Cancelled => {
                        running = false
                    }
                    _ => {
                        20.to_millis().sleep()
                    }
                }
            }
        }
    }
    }
    lst.close()

    // Bounded drain. Every accepted connection holds one admission permit
    // for its whole life, so "all permits back" IS "no connection in
    // flight" — no second counter is needed, and none is kept.
    //
    // The wait is BOUNDED on purpose: an unbounded drain turns one stuck
    // keep-alive connection into a server that never exits, which is the
    // failure mode graceful shutdown exists to avoid.
    ro drain_budget = policy.graceful_drain()
    mut waited = 0.to_millis()
    mut draining = drain_budget.nanos() > 0
    while draining {
        if inflight.available_permits() >= policy.max_inflight() {
            draining = false
        } else {
            if waited.nanos() >= drain_budget.nanos() {
                draining = false
            } else {
                20.to_millis().sleep()
                waited = (waited.nanos() + 20_000_000).to_nanos()
            }
        }
    }
}
