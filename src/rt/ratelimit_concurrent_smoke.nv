// SPDX-License-Identifier: MIT OR Apache-2.0
// `[M-ratelimit-buckets-unsynchronized-race]` (P1, owner decision
// 2026-08-01) — LIVE concurrency smoke for `middleware.ratelimit` over real
// loopback sockets (`serve_router()`), NOT `route_once` (the existing
// `../middleware/ratelimit_test.nv` pin suite is sequential/mock-only —
// `route_once` never exercises two REQUESTS ON DIFFERENT FIBERS touching
// the SAME shared bucket table at once, so it cannot reproduce the
// concurrent-`HashMap`-resize crash this P1 flagged). This file spawns
// `CONCURRENCY` client fibers that all connect and send their ONE request
// at roughly the same instant, all against ONE `RateLimit` middleware
// instance (one shared, `Mutex`-guarded `BucketTable`, `ratelimit.nv`).
//
// What this proves: (a) the server does not crash/hang under concurrent
// admission checks (the actual P1 — a HashMap resize race is memory-unsafe,
// not just "wrong count"); (b) the table still limits — MOST connections
// beyond `capacity` see 429, none see something other than 200/429 (a
// malformed/absent response would mean the shared state got corrupted).
// The exact admitted count is NOT asserted at strict equality: the
// documented, still-ACCEPTED per-bucket ±1-token race (`ratelimit.nv`'s own
// banner — `@acquire`'s read-modify-write has no lock of its own) can let
// slightly more or fewer than `capacity` through under true concurrency —
// this smoke only asserts that count stays CLOSE to `capacity`, not exact.
//
// EXPECT_TIMEOUT_MS 30000

module rt.ratelimit_concurrent_smoke

import std.net.{TcpListener, TcpStream, SocketAddr, real_net}
import polaris.{Router, ServerRequest, ServerResponse}
import polaris.middleware.ratelimit.{RateLimit, ratelimit}
import polaris.net.{ServerPolicy}
import polaris.serve.{serve_router}

const CONCURRENCY = 20
const CAPACITY = 5

fn limited_routes() Time -> Router {
    mut r = Router.new()
    r.use(ratelimit(RateLimit.new(CAPACITY, 0.01)))   // near-zero refill: no meaningful mid-test admission
    r.get("/x", fn(_req ServerRequest) -> ServerResponse => ServerResponse.text(200, "ok"))!!
    r
}

test "ratelimit(): CONCURRENCY connections at once against ONE shared bucket table — no crash, still throttles" {
    with Net = real_net() {
        // `port_tx` gets ONE send per client (not one shared value) — each
        // client spawn does its OWN `port_rx.recv()`, and a `Channel` value
        // is delivered to exactly ONE receiver (`serve_policy_smoke.nv`'s
        // own 2-client admission test documents/uses this same recipe).
        ro (port_tx, port_rx) = Channel.new(CONCURRENCY)
        ro (results_tx, results_rx) = Channel.new(CONCURRENCY)
        with Fail[TimeoutError] = |_e| {} {
            // ONE level of spawn nesting — every client is a DIRECT sibling
            // of the server spawn under this SAME `supervised` block (the
            // proven shape every other rt-smoke multi-client test in this
            // package uses, `serve_policy_smoke.nv` test 5). A nested
            // `spawn { supervised { for { spawn { ... } } } }` shape (tried
            // first) crashed `emit_c` with `use of undeclared identifier
            // 'chunk'/'code'/'s'` — a scoping defect under doubly-nested
            // spawns this file does not attempt to work around further;
            // flattening to one level sidesteps it entirely.
            supervised(timeout: 10.to_seconds()) {
                spawn {
                    consume lst = match TcpListener.bind(SocketAddr.loopback(0)) {
                        Ok(consume l)  => l
                        Err(_) => { for _i in 0..CONCURRENCY { ro _ = port_tx.try_send(0 as u16) }; return }
                    }
                    for _i in 0..CONCURRENCY { ro _ = port_tx.try_send(lst.local_port()) }
                    // `max_inflight(CONCURRENCY)`: the SOCKET-level admission
                    // gate (`ServerPolicy`, default 16) is a SEPARATE
                    // concern from the rate limiter under test — widen it so
                    // every one of the CONCURRENCY connections is admitted
                    // at the socket layer and the ONLY thing gating a 429 is
                    // `ratelimit.nv`'s own bucket table.
                    serve_router(lst, limited_routes(), ServerPolicy.new().max_inflight(CONCURRENCY))
                }
                for _i in 0..CONCURRENCY {
                    spawn {
                        ro port = match port_rx.recv() { Some(p) => p, None => 0 as u16 }
                        match TcpStream.connect(SocketAddr.loopback(port)) {
                            Ok(consume cli) => {
                                ro _ = cli.write_str("GET /x HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n")
                                match cli.read_bytes(4096) {
                                    Ok(chunk) => {
                                        ro s = unsafe { chunk.to_str_unchecked() }
                                        ro code = if s.contains("200") { 200 } else if s.contains("429") { 429 } else { 0 }
                                        ro _ = results_tx.try_send(code)
                                    }
                                    Err(_) => { ro _ = results_tx.try_send(0) }
                                }
                                cli.close()
                            }
                            Err(_) => { ro _ = results_tx.try_send(0) }
                        }
                    }
                }
            }
        }
        results_tx.close()
        mut got_200 = 0
        mut got_429 = 0
        mut got_other = 0
        mut n = 0
        mut more = true
        while more && n < CONCURRENCY {
            match results_rx.try_recv() {
                Some(code) => {
                    n += 1
                    if code == 200 { got_200 += 1 }
                    else if code == 429 { got_429 += 1 }
                    else { got_other += 1 }
                }
                None => { more = false }
            }
        }
        // (a) no crash/hang/corruption: every one of the CONCURRENCY
        // clients got a well-formed 200 or 429 — zero "other" (a
        // corrupted/garbled response would land here).
        assert(n == CONCURRENCY)
        assert(got_other == 0)
        // (b) still throttles: admitted count stays CLOSE to CAPACITY (±2
        // tolerance for the documented, accepted per-bucket race — see file
        // banner) — not "wide open" (would mean the limiter stopped
        // limiting) and not "zero admitted" (would mean it wedged shut).
        assert(got_200 >= CAPACITY - 2)
        assert(got_200 <= CAPACITY + 2)
        assert(got_429 == CONCURRENCY - got_200)
    }
}
