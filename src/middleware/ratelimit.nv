// SPDX-License-Identifier: MIT OR Apache-2.0
// nova-http: middleware/ratelimit.nv — `http.middleware.ratelimit` (Plan
// 222.12 Ф.5). Semantics: chi `middleware.Throttle` / `tower::limit`; the
// token bucket itself is the READY `std/concurrency/rate_limiter.nv`
// (`TokenBucket` — plan's explicit "обёртка, не реализация"). Form:
// chi-style `Middleware` (222.4).
//
// Time: `TokenBucket` runs on the `Time` effect (`Monotonic` refill) —
// ambient default in prod, `with Time = th.fixed_ms(...)` in tests makes
// refill fully deterministic (rate_limiter's own AI-first design carried
// through to the HTTP layer).
//
// State sharing: `TokenBucket` and `HashMap` are heap records (no `value` —
// IoCapture-precedent "the same instance is mutated"), so every
// closure/copy aliases ONE bucket table; a config built once and layered
// once limits the route set globally. Keying: default is ONE global bucket
// (chi Throttle shape); `per_client(true)` keys buckets by the first
// `X-Forwarded-For` hop (same trust caveat as middleware/log.nv `RealIP` —
// only meaningful behind a proxy that overwrites the header; absent header
// → the "" bucket).
//
// `[M-ratelimit-buckets-unsynchronized-race]` (P1, owner decision
// 2026-08-01): the bucket TABLE (`HashMap[str, TokenBucket]`) is now
// `Mutex`-protected (`BucketTable`, canon shape `metrics.nv`'s own
// `MetricsRegistry` — one `Mutex` guarding every `get`/`insert`) — the
// actual crash-under-load bug this P1 flagged (concurrent `insert` from
// different connections' fibers racing the SAME map's resize is real
// memory-unsafety, not a tolerance question). The retrieved `TokenBucket`
// handle is returned back to the caller UNLOCKED, and the KNOWN, STILL-
// ACCEPTED simplification below is unchanged: `TokenBucket` is a heap
// record (no `value` — IoCapture-precedent "the same instance is
// mutated"), and `@acquire` itself is a read-modify-write over fiber
// preempt points with no lock of its own — under true M:N parallelism two
// fibers can in principle both witness the last token of the SAME bucket.
// chi guards this with a mutex; our std rate_limiter ships without one, and
// the wrapper stays honest to it (an over-admission of ±1 token under
// contention throttles, not corrupts — a tolerance, not the crash the P1
// was about).
//
// 429 answers carry `Retry-After: ceil(1/refill_per_sec)` seconds — the
// earliest moment a single token can exist again.

module middleware.ratelimit

import polaris.{Handler, middleware, Middleware, ServerRequest, ServerResponse}
import std.concurrency.rate_limiter.{TokenBucket}
import std.collections.hashmap.{HashMap}
import std.runtime.sync.{Mutex}

/// Rate-limit config (fluent; finish with `@middleware()`).
/// `capacity` = burst size, `per_sec` = sustained refill rate.
#stable(since = "0.1")
export type RateLimit value priv {
    capacity   int
    per_sec    f64
    per_client bool
}

/// `capacity` tokens of burst, refilled at `per_sec` tokens/second.
#stable(since = "0.1")
export fn RateLimit.new(capacity int, per_sec f64) -> RateLimit =>
    { capacity, per_sec, per_client: false }

/// Key buckets by the first `X-Forwarded-For` hop instead of one global
/// bucket (default OFF; trust caveat in the file banner).
#stable(since = "0.1")
export fn RateLimit mut @per_client(on bool) -> @ { @per_client = on }

/// Build the middleware. `Time` row: the shared bucket table is created here
/// (ambient default in prod; a test builds under `th.fixed_ms`).
#stable(since = "0.1")
export fn RateLimit @middleware() Time -> Middleware {
    ro cfg = @
    // `mut` (not `ro`): this is the SHARED bucket table, captured by the
    // closure below and threaded into `rl_apply` as a `mut` in-out param on
    // every request (D246 canon (a) — genuinely in-out: mutations from one
    // request must be visible to the next, the entire point of rate
    // limiting, not an independent-copy case). `BucketTable` (below) is the
    // `Mutex`-guarded wrapper — [M-ratelimit-buckets-unsynchronized-race].
    mut table = BucketTable.new()
    middleware(fn(req ServerRequest, next Handler) -> ServerResponse => rl_apply(cfg, table, next, req))
}

/// Convenience: `ratelimit(RateLimit.new(100, 50.0))` → ready `Middleware`.
#stable(since = "0.1")
export fn ratelimit(cfg RateLimit) Time -> Middleware => cfg.middleware()

// ── internals ───────────────────────────────────────────────────────────────

// Shared bucket table — `Mutex`-guarded (canon `metrics.nv`'s
// `MetricsRegistry`): every `get`/`insert` against the shared `HashMap` goes
// through ONE lock. Value type over reference-semantics fields (`Mutex`/
// `HashMap`) — every copy aliases the SAME table.
type BucketTable value priv {
    lock    Mutex
    buckets HashMap[str, TokenBucket]
}

fn BucketTable.new() -> BucketTable =>
    { lock: Mutex.new(), buckets: HashMap[str, TokenBucket].new() }

// Get-or-create the bucket for `key` under the table's lock; the returned
// `TokenBucket` handle is UNLOCKED (see file banner — `@acquire`'s own
// per-bucket ±1-token race is the pre-existing, accepted simplification,
// unrelated to the table-corruption bug this Mutex closes).
fn BucketTable @bucket_for(key str, capacity int, per_sec f64) Time -> TokenBucket {
    consume g = @lock.lock()
    ro b = match @buckets.get(key) {
        Some(existing) => existing
        None => {
            ro nb = TokenBucket.new(capacity as i64, per_sec)
            ro _ = @buckets.insert(key, nb)
            nb
        }
    }
    g.unlock()
    b
}

// `next` arrives as a PARAM — `next(req)` is the safe D52 param call-through
// ([M-16] discipline, see cors.nv `cors_apply`). The flat `middleware(...)`
// closure above captures only the two locals (`cfg`, `table` — the SHARED
// bucket table, one per built middleware value).
fn rl_apply(cfg RateLimit, mut table BucketTable, next Handler, req ServerRequest) Time -> ServerResponse {
    ro key = if cfg.per_client { client_key(req) } else { "" }
    mut bucket = table.bucket_for(key, cfg.capacity, cfg.per_sec)
    if bucket.acquire() {
        next(req)
    } else {
        mut resp = ServerResponse.text(429, "429 too many requests")
        resp.header("Retry-After", "${retry_after_secs(cfg.per_sec)}")
        resp
    }
}

// First X-Forwarded-For hop, trimmed ("" when absent).
fn client_key(req ServerRequest) -> str {
    match req.header("x-forwarded-for") {
        Some(xff) => {
            ro first = match xff.find(",") {
                Some(i) => xff[0..i]
                None    => xff
            }
            first.trim_ascii()
        }
        None => ""
    }
}

// ceil(1/per_sec), at least 1 second.
fn retry_after_secs(per_sec f64) -> int {
    if per_sec <= 0.0 { return 1 }
    ro s = 1.0 / per_sec
    ro n = s as int
    ro up = if (n as f64) < s { n + 1 } else { n }
    if up < 1 { 1 } else { up }
}
