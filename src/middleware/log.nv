// SPDX-License-Identifier: MIT OR Apache-2.0
// nova-http: middleware/log.nv — `http.middleware.log` (Plan 222.12 Ф.2).
// Semantics: chi `middleware.Logger` + `RequestID` + `RealIP` folded into ONE
// configurable middleware (chi ships three; our config toggles cover the same
// surface without three separate layer registrations). Form: chi-style
// `Middleware` (222.4 core).
//
// Per request: method, path, status, response-body size and wall duration
// (`Monotonic` pair around `next.handle` — `Time` effect; ambient default in
// prod, `with Time = th.fixed_ms(...)` in tests makes every line
// deterministic, same recipe as std/concurrency/rate_limiter_test.nv).
// `X-Request-Id` is propagated from the request when present (and safe) or
// generated from an `AtomicInt` counter built alongside the closure in
// `@middleware()` (same shape as `ratelimit.nv`'s `BucketTable` — the
// counter is captured once per built middleware and threaded through
// `log_apply` -> `request_id_of` as a `mut` in-out param on every request,
// D246 canon (a) genuinely in-out; `AtomicInt` is itself a `#share` cell
// (D415), so every hop threaded through stays pointed at the same counter
// (Plan 248 wave 3: `AtomicInt` is now value-inside/`#no_copy` — the `mut`
// param is a pointer to the caller's slot, not a copy, D246/Plan 184 P10).
// `RealIP` is OPT-IN (chi's own caveat: `X-Forwarded-For` is
// client-controlled — only enable behind a proxy you trust to overwrite it).
//
// Effect note: the wrapped handler's BODY calls `Time`-row AND `Log`-row
// (raw op, see below) functions while `Handler` stays the pure
// `fn(ServerRequest) -> ServerResponse` — `Time` is allowed because it has
// an ambient default handler (probed and pinned by the flagship
// aggregator's `snapshot_body`, examples/flagship §banner); `Log.info(...)`
// below is a RAW op call (design note §0 Ф-C, `log.nv`'s own banner) — not
// checked under `--strict-effects` at all, so it needs neither `with` nor a
// row entry on any function in this file.
//
// Closure discipline ([M-16]-family, see middleware/cors.nv): struct params
// are copied to locals before capture; every closure captures only from its
// direct enclosing scope.
//
// Plan 222.20 Ф.3 Волна A (§Q3): this middleware's config record was named
// bare `Log` — collided (same-CU bare-name lookup, this package's own
// documented failure class, see `ServerPolicy`'s banner in
// `net/config.nv`) with the new ambient `Log` EFFECT (`log.nv`, `polaris`
// root) once introduced. Renamed to `AccessLog` (parallel to its `Cors`
// sibling — a feature-named config, not a generic `Log`; the other two
// original siblings this pattern was named after have since been collapsed
// to bare functions, [M-ratelimit-compression-flatten-to-default-args]);
// the config's own former `emit` field + `@sink(f)` setter
// (an independent hand-rolled copy of the SAME sink pattern `background.nv`
// and `net/config.nv` also had) are gone — `log_apply` below calls
// `Log.info(...)` directly, tests intercept via
// `with Log = capture_log(lines) { ... }`.

module middleware.log

import polaris.{Handler, middleware, Middleware, ServerRequest, ServerResponse, Log}
import std.runtime.sync.{AtomicInt}
import std.time.duration

/// Access-log middleware config (fluent; finish with `@middleware()`).
/// Defaults: request-id ON, real-ip OFF. Log lines go through the ambient
/// `Log` effect (`polaris.Log`, `log.nv`) — stdout by default, redirectable
/// in tests via `with Log = capture_log(lines) { ... }`.
#stable(since = "0.1")
export type AccessLog value priv {
    request_id bool
    real_ip    bool
}

/// Default config: request-id on, real-ip off.
#stable(since = "0.1")
export fn AccessLog.new() -> AccessLog =>
    { request_id: true, real_ip: false }

/// Toggle `X-Request-Id` propagation/generation (default ON).
#stable(since = "0.1")
export fn AccessLog mut @request_id(on bool) -> @ { @request_id = on }

/// Include the first `X-Forwarded-For` hop in the line (default OFF — the
/// header is client-controlled; enable only behind a trusted proxy, chi
/// `RealIP`'s own warning).
#stable(since = "0.1")
export fn AccessLog mut @real_ip(on bool) -> @ { @real_ip = on }

/// Build the middleware. `Time` row: the per-request line measures elapsed
/// time via `Monotonic.now()` (ambient default in prod; a test builds under
/// `th.fixed_ms` — same row-declaration chain as `ratelimit()`,
/// strict-effects package gate 222 §9). `Log` is NOT in this row — the
/// per-request line is emitted through a raw `Log.info(...)` op inside
/// `log_apply` (design note §0 Ф-C), which `--strict-effects` does not
/// check.
#stable(since = "0.1")
fn AccessLog @middleware() Time -> Middleware {
    ro cfg = @
    // Request-id counter — same shape as `ratelimit.nv`'s `mut table =
    // BucketTable.new()`: built once per middleware value, captured by the
    // closure below, and threaded through as a `mut` in-out param on every
    // request. NOT a config field ([№354], rule 38 nv-coding-style — a
    // request counter is runtime state, not something you can write to a
    // config file).
    mut counter = AtomicInt.new(0)
    middleware(fn(req ServerRequest, next Handler) -> ServerResponse => log_apply(cfg, counter, next, req))
}

/// Convenience: `logger(AccessLog.new())` → ready `Middleware` (chi's name).
#stable(since = "0.1")
export fn logger(cfg AccessLog) Time -> Middleware => cfg.middleware()

// ── internals ───────────────────────────────────────────────────────────────

// `next` arrives as a PARAM — `next(req)` is the safe D52 param call-through
// ([M-16]: a CAPTURED Handler must not be called by identifier; the flat
// `middleware(...)` closure above captures `cfg` and `counter` and passes
// `next` through as its own closure param).
fn log_apply(cfg AccessLog, mut counter AtomicInt, next Handler, req ServerRequest) Time -> ServerResponse {
    ro t0 = Monotonic.now()
    ro id = if cfg.request_id { request_id_of(counter, req) } else { "" }
    mut resp = next(req)
    ro ms = Monotonic.now().elapsed_since(t0).millis()
    if id != "" { resp.header("X-Request-Id", id) }
    consume sb = StringBuilder.new()
    sb.cap(96)
    if id != "" {
        sb.append("[${id}] ")
    }
    sb.append("${req.method().str()} ${req.path()} -> ${resp.status_code()} ${resp.body.len()}B in ${ms}ms")
    if cfg.real_ip {
        ro ip = real_ip_of(req)
        if ip != "" { sb.append(" from ${ip}") }
    }
    // Raw `Log` op (design note §0 Ф-C) — `log_apply`'s own row stays
    // `Time` only, see this file's banner.
    Log.info(sb.into_str())
    resp
}

// Incoming `X-Request-Id` (if header-safe and short) or a fresh `req-<n>`.
//
// `counter` arrives as a top-level `mut` param, threaded straight from
// `@middleware()`'s closure ([№354] — no longer a field reached through the
// readonly `cfg` chain, so no local copy is needed to satisfy D33's
// mut-root rule: the param binding itself IS the root). `AtomicInt` being a
// `#share` cell (D415) is what keeps every hop of the thread — and every
// closure invocation across requests — pointed at the SAME counter.
//
// Plan 248 (wave 3, D447 #no_copy): the fresh-id computation used to live in
// a separate `fresh_id(mut counter AtomicInt)` helper, called from both
// match arms below. Inlined here (early-`return` on the safe-token path,
// fall-through otherwise) because `#no_copy`'s borrow check (wave 2) is
// conservative about a SECOND hop: `request_id_of` legitimately borrows
// `counter` (a `mut` param, D246/Plan 184 P10 — pointer, not a copy), but
// forwarding that SAME borrow on as `fresh_id`'s own argument counts as an
// escape under the current (documented v1) rule, which doesn't verify what
// the callee-of-the-callee does with it — a real, if narrow, gap (separate
// from this fix; the borrow-vs-copy distinction itself is sound, only
// multi-hop borrow chains aren't recognized yet). Removing the extra hop
// sidesteps it without touching the compiler further; behavior unchanged.
fn request_id_of(mut counter AtomicInt, req ServerRequest) -> str {
    match req.header("x-request-id") {
        Some(id) => if safe_token(id) { return id }
        None     => {}
    }
    ro n = counter.fetch_add(1) + 1
    "req-${n}"
}

// First `X-Forwarded-For` hop, trimmed ("" when absent/unsafe).
fn real_ip_of(req ServerRequest) -> str {
    match req.header("x-forwarded-for") {
        Some(xff) => {
            ro first = match xff.find(",") {
                Some(i) => xff[0..i]
                None    => xff
            }
            ro ip = first.trim_ascii()
            if safe_token(ip) { ip } else { "" }
        }
        None => ""
    }
}

// Visible-ASCII, bounded — safe both for the panicking `resp.header` setter
// and for keeping log lines one-line (no CR/LF smuggling into the sink).
fn safe_token(s str) -> bool {
    if s.byte_len() == 0 || s.byte_len() > 64 { return false }
    for c in s.chars() {
        ro cp = c as int
        if cp < 0x21 || cp > 0x7E { return false }
    }
    true
}
