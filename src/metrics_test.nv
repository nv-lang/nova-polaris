// SPDX-License-Identifier: MIT OR Apache-2.0
// nova-http: metrics_test.nv — `MetricsRegistry` (Plan 222.23 Ф.1). Plain
// value-type tests — no effect/handler involved (see `metrics.nv`'s own
// banner for why the ambient-effect design was dropped).

module polaris

test "MetricsRegistry: counter starts at 0, record_counter accumulates" {
    ro reg = MetricsRegistry.new()
    assert(reg.counter_value("accepted_total") == 0)
    reg.record_counter("accepted_total", 1)
    reg.record_counter("accepted_total", 2)
    assert(reg.counter_value("accepted_total") == 3)
    // A name never recorded stays at 0 — independent cells per name.
    assert(reg.counter_value("rejected_total") == 0)
}

test "MetricsRegistry: gauge is last-write-wins" {
    ro reg = MetricsRegistry.new()
    assert(reg.gauge_value("inflight") == 0.0)
    reg.record_gauge("inflight", 3.0)
    assert(reg.gauge_value("inflight") == 3.0)
    reg.record_gauge("inflight", 1.0)
    assert(reg.gauge_value("inflight") == 1.0)
}

test "MetricsRegistry: render_prometheus emits a TYPE line and the value per metric" {
    ro reg = MetricsRegistry.new()
    reg.record_counter("accepted_total", 5)
    reg.record_gauge("inflight", 2.0)
    ro text = reg.render_prometheus()
    assert(text.contains("# TYPE accepted_total counter"))
    assert(text.contains("accepted_total 5"))
    assert(text.contains("# TYPE inflight gauge"))
    assert(text.contains("inflight 2"))
}

test "metrics_routes: GET /metrics renders the registry as Prometheus text" {
    ro reg = MetricsRegistry.new()
    reg.record_counter("rejected_total", 7)
    mut r = Router.new()
    r = metrics_routes(r, reg)!!
    ro wire = serve_once(r, "GET /metrics HTTP/1.1\r\nHost: x\r\n\r\n".bytes())
    ro s = unsafe { wire.to_str_unchecked() }
    assert(s.contains("HTTP/1.1 200 OK"))
    assert(s.contains("rejected_total 7"))
}
