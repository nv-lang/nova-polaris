// SPDX-License-Identifier: MIT OR Apache-2.0
// polaris: serve/facade.nv — одна строка, с которой начинают.
//
// ЗАЧЕМ ОТДЕЛЬНЫЙ ФАЙЛ, А НЕ СТРОКА В `serve.nv`. Там в области файла уже
// живёт импортированное имя `serve` (`import polaris.net.{…, serve, …}` —
// байтовый accept-loop нижнего слоя), и объявить рядом СВОЙ `serve` значит
// столкнуть два имени в одном файле. Пир модуля решает это без переименований:
// имя объявляется в модуле `polaris.serve`, а импорт нижнего слоя остаётся
// файловым делом соседа.
//
// ПОЧЕМУ ФАСАД ВООБЩЕ ЕСТЬ (решение владельца 2026-09-18, план 274.11 п.1).
// Приёмка 222.22 требовала, чтобы пример из README работал ДОСЛОВНО, а в
// README стояла форма с листенером и политикой: `serve_router(listener, app,
// ServerPolicy.new())` — три понятия до «hello world». Замер показал, что
// БУКВАЛЬНАЯ форма `polaris.serve(app, addr)` требует функции в КОРНЕВОМ
// модуле, то есть взаимной зависимости корня и `polaris.serve`; шапка
// `serve.nv` описывает этот случай не опасением, а замером (ложные «undefined
// identifier» — подпись цикла A⇄B). Поэтому выбрана форма (а): короткая
// функция ЗДЕСЬ, слоевой контракт не трогаем.
module polaris.serve

import std.net.{NetError}
import polaris.{Router}
import polaris.net.{ServerPolicy}

/// Поднять сервер по адресу с политикой по умолчанию — самая короткая форма,
/// и единственная, которая нужна, пока не понадобилась настройка.
///
/// ```nova
/// serve(app, ":8080")
/// ```
///
/// `":8080"` слушает все интерфейсы. Разбор адреса и привязка — как у
/// `serve_addr`, туда же уходит и ошибка: неверный адрес или занятый порт
/// возвращаются значением `Err`, а не паникой.
///
/// **Когда этой формы не хватает** — берите `serve_addr` (своя `ServerPolicy`:
/// keep-alive, дедлайны, предел тела, admission control) или `serve_router`
/// (уже привязанный `TcpListener`). Фасад ничего не скрывает от них: он ровно
/// `serve_addr` с `ServerPolicy.new()`.
///
/// `stop` (необязательный, по имени — D102): отмените его, и accept-loop
/// завершится, а вызов ВЕРНЁТСЯ; без него цикл живёт вечно.
#stable(since = "0.1")
export fn serve(router Router, addr str, stop Option[CancelToken] = None) Net Time Detach -> Result[(), NetError] =>
    serve_addr(addr, router, ServerPolicy.new(), stop: stop)
