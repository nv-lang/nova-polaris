// SPDX-License-Identifier: MIT OR Apache-2.0
// Polaris example 02 — routing: path patterns, MethodRouter, nest, fallbacks,
// and a route conflict caught at startup instead of crashing the process.
// By way of: axum's `routes-and-handlers-close-together`, chi routing.

module main

import polaris.{Router, MethodRouter, ServerRequest, ServerResponse, get, post}
import polaris.net.{ServerPolicy}
import polaris.serve.{serve_router, handle_connection_router}
import polaris.{StatusCode}
import std.net.{TcpListener, SocketAddr}
import std.io.{println}

// `{id}` matches exactly one segment; `{*rest}` is a catch-all and must be
// the pattern's last segment.
fn user_handler(req ServerRequest) -> ServerResponse {
    ro id = req.param("id") ?? "?"
    ServerResponse.text(StatusCode.OK, "user ${id}")
}

fn files_handler(req ServerRequest) -> ServerResponse {
    ro path = req.param("path") ?? "?"
    ServerResponse.text(StatusCode.OK, "path=${path}")
}

// `nest`-ed under /api below — same handler, reachable at both /widgets/{id}
// (this router alone) and /api/widgets/{id} (once nested).
fn widget_handler(req ServerRequest) -> ServerResponse {
    ro id = req.param("id") ?? "?"
    ServerResponse.text(StatusCode.OK, "widget ${id}")
}

fn build_router() -> Router {
    mut top = Router.new()
    top.fallback(fn(req ServerRequest) -> ServerResponse => ServerResponse.text(StatusCode.NOT_FOUND, "custom 404: nothing here"))
    top.get("/users/{id}", user_handler)!!
    top.get("/files/{*path}", files_handler)!!

    // MethodRouter: get(h).post(h2) on one path -> 405+Allow on any other
    // method, no extra code needed.
    top.route("/widgets",
        get(fn(req ServerRequest) -> ServerResponse => ServerResponse.text(StatusCode.OK, "list"))
            .post(fn(req ServerRequest) -> ServerResponse => ServerResponse.text(StatusCode.CREATED, "created")))!!

    // A router-scoped MethodRouter with its OWN 405 override, nested under /api.
    mut api = Router.new()
    api.get("/widgets/{id}", widget_handler)!!
    mut guarded = get(fn(req ServerRequest) -> ServerResponse => ServerResponse.text(StatusCode.OK, "guarded ok"))
    guarded.fallback(fn(req ServerRequest) -> ServerResponse => ServerResponse.text(StatusCode.METHOD_NOT_ALLOWED, "custom 405: guarded"))
    api.route("/guarded", guarded)!!
    top.nest("/api", api)!!

    // Route conflicts are typed errors, never a panic — registering the
    // same path twice at startup is caught and logged, not a crash.
    ro dup = top.route("/widgets", get(fn(req ServerRequest) -> ServerResponse => ServerResponse.text(StatusCode.OK, "dup")))
    match dup {
        Ok(_)  => println("unexpected: duplicate route accepted")
        Err(_) => println("expected: duplicate /widgets registration rejected as a typed Err, not a panic")
    }
    top
}

/// Canonical production shape (serving.md) — compile-checked, never called.
/// See examples/README.md for why `main()` below drives the loop by hand.
fn production_main() Net Time Detach -> () {
    consume listener = TcpListener.bind(SocketAddr.from_str("0.0.0.0:18083")!!)!!
    serve_router(listener, build_router(), ServerPolicy.new())
}

fn main() Net Detach -> () {
    ro app = build_router()
    supervised {
        spawn {
            consume listener = TcpListener.bind(SocketAddr.from_str("0.0.0.0:18083")!!)!!
            while true {
                match listener.accept() {
                    Ok(consume stream) => { ro _ = handle_connection_router(stream, app) }
                    Err(_) => ()
                }
            }
        }
    }
}
