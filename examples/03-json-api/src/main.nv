// SPDX-License-Identifier: MIT OR Apache-2.0
// Polaris example 03 — json-api: REST CRUD over an in-memory todo list.
// `Json[T]` extraction on the way in, `ServerResponse.json`/the `Serialize`
// blanket on the way out, `#impl(Serialize + Deserialize)` on the domain
// type, `HttpError`/`StatusCode` for the not-found/bad-input paths.
// By way of: axum's `todos` example, the FastAPI tutorial's items CRUD.

module main

import polaris.{Router, ServerRequest, ServerResponse, Json, PathParam, Query, FromRequest, FromPath, FromQuery, FromBody, TypedRoute, get, post, put, delete}
import polaris.net.{ServerPolicy}
import polaris.serve.{serve_router}
import polaris.{StatusCode, HttpError}
import polaris.{openapi_handler}
import std.net.{TcpListener, SocketAddr}
import std.encoding.serde.{Serialize, Deserialize}
import std.reflect.{Reflect, TypeShape}

#impl(Serialize + Deserialize)
type Todo value { ro id int, ro title str, ro done bool }

// Separate input shapes: a client creating a todo supplies only a title; a
// client updating one supplies both fields it may change. Keeps `Todo`
// itself (with its server-assigned `id`) out of what a client can dictate.
#impl(Deserialize)
type NewTodo value { ro title str }

#impl(Deserialize)
type TodoUpdate value { ro title str, ro done bool }

// ── Plan 222.3 «РЕШЕНИЕ 2026-07-31»: `POST /todos/{id}/note` combines a
// PATH param (which todo) + a QUERY flag (pin it right away?) + a JSON body
// (the note text) — паритет-форма ЛУЧШЕ Axum: каждый тип-параметр объявляет
// СВОЙ источник САМ (`#impl(FromPath)`/`#impl(FromQuery)`/`#impl(FromBody)`,
// polaris/extract.nv), хендлер получает ГОЛЫЕ типы без обёрток/`.data()`.
// Каждый `#impl` здесь тонко форвардит на уже проверенный generic-путь
// (`PathParam[T]`/`Query[T]`/`Json[T]`'s `from_request`, extract.nv) —
// сам форвард НЕ generic-диспетч на fn-параметре, поэтому не задевает
// открытый №140 (см. `FromPath`'s doc-banner в extract.nv: №140 блокирует
// GENERIC-регистрацию (`post_typed`, принимающий голый `h`), НЕ голые типы
// параметров как таковые — оттого регистрация ниже остаётся низкоуровневой
// `TypedRoute`, но сам ХЕНДЛЕР уже пишется с голыми типами).
#impl(Serialize + Deserialize + Reflect)
type TodoIdParam value { ro id int }

#impl(Serialize + Deserialize + Reflect)
type NoteQuery value { ro pinned bool }

#impl(Serialize + Deserialize + Reflect)
type NoteBody value { ro text str }

#impl(FromPath)
fn TodoIdParam.from_path(req ServerRequest) -> Result[TodoIdParam, HttpError] {
    match PathParam[TodoIdParam].from_request(req) {
        Ok(p)  => Ok(p.data())
        Err(e) => Err(e)
    }
}

#impl(FromQuery)
fn NoteQuery.from_query(req ServerRequest) -> Result[NoteQuery, HttpError] {
    match Query[NoteQuery].from_request(req) {
        Ok(q)  => Ok(q.data())
        Err(e) => Err(e)
    }
}

#impl(FromBody)
fn NoteBody.from_body(req ServerRequest) -> Result[NoteBody, HttpError] {
    match Json[NoteBody].from_request(req) {
        Ok(j)  => Ok(j.data())
        Err(e) => Err(e)
    }
}

/// Голый typed-хендлер (Ф.2/Ф.3, паритет-форма): три голых типа-параметра,
/// источник читается по значению-типу (`TodoIdParam`=path, `NoteQuery`=query,
/// `NoteBody`=body). `items`/`find_by_id` — захваченное состояние примера
/// (не языковое ограничение) — передаётся явно, а не через closure-захват,
/// т.к. `add_note` не вложена в `build_router` (нужна отдельным top-level
/// именем для читаемости регистрации ниже).
fn add_note(id TodoIdParam, opts NoteQuery, note NoteBody, items Vec[Todo]) -> ServerResponse {
    match find_by_id(items, id.id) {
        Some(t) => ServerResponse.text(200, "noted id=${t.id} pinned=${opts.pinned} text=${note.text}")
        None    => not_found()
    }
}

fn not_found() -> ServerResponse => HttpError.new(Status(StatusCode.NOT_FOUND)).into_response()

fn bad_request() -> ServerResponse => HttpError.new(Status(StatusCode.BAD_REQUEST)).into_response()

fn find_by_id(items Vec[Todo], id int) -> Option[Todo] {
    for t in items {
        if t.id == id { return Some(t) }
    }
    None
}

fn build_router() -> Router {
    mut items Vec[Todo] = Vec[Todo].new()
    mut next_id = 1

    // Every path that carries MORE THAN ONE HTTP method here is registered
    // as ONE explicit `MethodRouter` chain (`get(h).post(h2)`, `get(h).put(
    // h2).delete(h3)`), never as separate same-path `.get()`/`.post()`/…
    // calls on the same router — confirmed via minimal repro during this
    // wave: two-or-more independent same-path registrations, each a closure
    // separately capturing + looping over the outer `mut items`, hit a
    // currently-open codegen gap at *registration* time (crashes before the
    // first request even arrives); the exact same handlers as one shared
    // `MethodRouter` chain do not. Filed upstream — every OTHER example in
    // this set (02-routing included) registers single-method routes the
    // plain way; this file needs the chained form throughout because every
    // one of its paths carries 2-3 methods over the same captured state.
    mut app = Router.new()
        .route("/todos",
            get(fn(req ServerRequest) -> ServerResponse => ServerResponse.json(StatusCode.OK, items))
            .post(fn(req ServerRequest) -> ServerResponse {
                match Json[NewTodo].from_request(req) {
                    Ok(body) => {
                        ro created = Todo { id: next_id, title: body.data().title, done: false }
                        next_id += 1
                        items.push(created)
                        ServerResponse.json(StatusCode.CREATED, created)
                    }
                    Err(e) => e.into_response()
                }
            }))!!
        .route("/todos/{id}",
            get(fn(req ServerRequest) -> ServerResponse {
                match (req.param("id") ?? "").to_int() {
                    Ok(id) => match find_by_id(items, id) {
                        Some(t) => ServerResponse.json(StatusCode.OK, t)
                        None    => not_found()
                    }
                    Err(_) => bad_request()
                }
            }).put(fn(req ServerRequest) -> ServerResponse {
                match (req.param("id") ?? "").to_int() {
                    Ok(id) => match find_by_id(items, id) {
                        Some(_) => match Json[TodoUpdate].from_request(req) {
                            Ok(body) => {
                                ro updated = Todo { id, title: body.data().title, done: body.data().done }
                                mut i = 0
                                mut done_updating = false
                                while i < items.len() && !done_updating {
                                    ro existing = items[i]
                                    if existing.id == id { items[i] = updated; done_updating = true }
                                    i += 1
                                }
                                ServerResponse.json(StatusCode.OK, updated)
                            }
                            Err(e) => e.into_response()
                        }
                        None => not_found()
                    }
                    Err(_) => bad_request()
                }
            }).delete(fn(req ServerRequest) -> ServerResponse {
                match (req.param("id") ?? "").to_int() {
                    Ok(id) => match find_by_id(items, id) {
                        Some(_) => {
                            mut i = 0
                            mut removed = false
                            while i < items.len() && !removed {
                                ro existing = items[i]
                                if existing.id == id { ro _ = items.remove(i); removed = true } else { i += 1 }
                            }
                            ServerResponse.empty(StatusCode.NO_CONTENT)
                        }
                        None => not_found()
                    }
                    Err(_) => bad_request()
                }
            }))!!

    // `POST /todos/{id}/note` — a UNIQUE path, registered via
    // `@post_typed`/`TypedRoute` (Plan 222.3 «РЕШЕНИЕ 2026-07-31»,
    // паритет-форма). `add_note` above takes THREE BARE types
    // (`TodoIdParam`/`NoteQuery`/`NoteBody`, each declaring its OWN source
    // via `#impl(FromPath)`/`#impl(FromQuery)`/`#impl(FromBody)` — no
    // `PathParam[T]`/`Query[T]`/`Json[T]` wrapper, no `.data()` unwrapping).
    // Registration itself STAYS low-level (`TypedRoute{handler: fn(req)->..}`)
    // — the compiler gap that blocks a GENERIC `post_typed[T1,T2,T3](path, h)`
    // overload calling its own bare-fn parameter `h` (№140, reconfirmed open
    // this wave — see `FromPath`'s doc-banner in `polaris/extract.nv`) is
    // NOT this route's problem to route around; the adapter closure below is
    // a hand-written, ordinary, NON-generic closure (safe — each `.from_path`/
    // `.from_query`/`.from_body` call is a concrete, non-generic dispatch).
    //
    // `req_shape`: hand-built `TypeShape.Record` with each field tagged by
    // its EXTRACTION ROLE ("PathParam"/"Query"/"Json" — the SAME role-tag
    // convention `polaris.openapi`'s emitter already reads off a bundle
    // record's wrapper-typed fields, plan §1.3 item 6), but calling
    // `.reflect()` DIRECTLY on each bare CONCRETE type (`TodoIdParam`/
    // `NoteQuery`/`NoteBody`) — NOT through a generic wrapper VALUE's
    // field-walk, so this does NOT exercise the known
    // `[M-reflect-derive-generic-wrapper-field-null-shape]` gap (P1,
    // `docs/plans/backlog-followups.md`) that blocked this before: that bug
    // is in auto-derived `#impl(Reflect)` field-walking a GENERIC wrapper
    // TYPE's own fields, not in calling a concrete type's own `.reflect()`
    // directly, which bare types have always done safely.
    ro note_req_shape = TypeShape.Record("AddNoteReq", [
        ("id",   TypeShape.Record("PathParam", [("data", TodoIdParam.reflect())])),
        ("opts", TypeShape.Record("Query",     [("data", NoteQuery.reflect())])),
        ("note", TypeShape.Record("Json",      [("data", NoteBody.reflect())])),
    ])
    app.post_typed("/todos/{id}/note", TypedRoute{
        handler: fn(req ServerRequest) -> ServerResponse {
            match TodoIdParam.from_path(req) {
                Ok(id) => match NoteQuery.from_query(req) {
                    Ok(opts) => match NoteBody.from_body(req) {
                        Ok(note) => add_note(id, opts, note, items)
                        Err(e)   => e.into_response()
                    }
                    Err(e) => e.into_response()
                }
                Err(e) => e.into_response()
            }
        },
        req_shape: Some(note_req_shape),
        resp_shape: None,
    })!!

    // Plan 222.8 Ф.3 — `/openapi.json`, EXPLICIT registration ("одна
    // дверь", no magic in `serve_router`). Introspected AFTER every other
    // route is registered (so it sees all of them) but the handler itself
    // is built/cached ONCE here, before `serve` — zero per-request cost.
    // Every route on this page carries `None`/`None` shapes today (see
    // `/todos/{id}/note`'s own comment above for why) — the emitted doc
    // documents paths + methods without rich per-field schemas; still real
    // end-to-end wiring against a real, running Router.
    ro routes = app.introspect()
    app.get("/openapi.json", openapi_handler(routes, "03-json-api Todo list", "1.0.0"))!!
    app
}

/// Canonical production shape (serving.md/overview.md): `main` IS the accept
/// loop, no `supervised { spawn { ... } }` wrapper needed — main-body runs as
/// its own fiber, so a blocking `serve_router` call works directly.
fn main() Net Time Detach -> () {
    ro app = build_router()
    consume listener = TcpListener.bind("0.0.0.0:18084".to_socket_addr()!!)!!
    serve_router(listener, app, ServerPolicy.new())
}
