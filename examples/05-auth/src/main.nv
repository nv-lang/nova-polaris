// SPDX-License-Identifier: MIT OR Apache-2.0
// Polaris example 05 — auth: Basic + Bearer/JWT, a session cookie, and a
// public/private zone split via `nest` + `.use()`.
// By way of: axum's `jwt` example, the FastAPI OAuth2/security tutorial.

module main

import polaris.{Router, ServerRequest, ServerResponse, Bearer, BasicAuth, JwtAuth, JwtClaims, require_jwt}
import polaris.{SessionConfig, session, memory_session_store}
import polaris.net.{ServerPolicy}
import polaris.serve.{serve_router}
import polaris.{StatusCode, HttpError}
import std.net.{TcpListener}
import std.encoding.serde.{Deserialize}
import std.encoding.json.{JsonValue, Json}
import std.crypto.jwt.{Jwt}
import std.testing.handlers.{seeded}
import std.io.{println}

fn jwt_secret() -> []u8 => "example-secret-do-not-use-in-prod".bytes()

// [M-example-fixed-clock]: `JwtAuth.claims_at` takes an explicit clock
// (`now_ms u64`, no effect row — Handler stays effect-free, see docs/auth.md).
// `require_jwt` itself now declares the `Time` effect (222.20 волна B) — a
// real service just calls it under the ambient system clock; this demo
// fixes `claims_at`'s own clock far in the future so an unexpired demo
// token never needs re-minting, independent of `require_jwt`'s Time use.
fn demo_now() -> u64 => 4_000_000_000

#serde(allow_unknown)
#impl(Deserialize)
type AuthClaims value { ro sub str }

fn mint_token(sub str) -> str {
    // Map literal + sum-coercion: "..." -> Str, 5e9 -> Num (spec: record
    // literal as map). `JsonValue.object(...)` stays until `JsonObject`
    // exposes the map-literal protocol (queued std-API polish).
    ro fields IndexMap[str, JsonValue] = { sub, exp: 5_000_000_000.0 }
    Jwt.encode_hs256(jwt_secret(), JsonValue.object(fields))
}

fn build_router() Time Random -> Router {
    ro auth = JwtAuth.new(jwt_secret())

    // session: a fresh session id + Set-Cookie on the first hit, the
    // same id (no new Set-Cookie) on every request that echoes the cookie
    // back. Store is now an ambient `SessionStore` effect (222.20 волна B,
    // `with SessionStore = memory_session_store(...)` in `main`, wraps the
    // whole `serve_router` call below) — no longer a value threaded through
    // `.use()`.
    ro cfg = SessionConfig.new().with_cookie_name("sess")
    ro sess_r = Router.new()
        .use(session(cfg))
        .get("/whoami", fn(req ServerRequest) -> ServerResponse {
            ro sid = req.param("session_id") ?? "?"
            ServerResponse.text(StatusCode.OK, "session=${sid}")
        })!!

    // ── private zone: every route nested here requires a valid JWT ──────
    ro priv_r = Router.new()
        .use(require_jwt(auth))
        .get("/me", fn(req ServerRequest) -> ServerResponse {
            match auth.claims_at[AuthClaims](req, demo_now()) {
                Ok(c)  => ServerResponse.text(StatusCode.OK, "sub=${c.claims().sub}")
                Err(e) => e.into_response()
            }
        })!!

    // ── public zone: no auth at all ────────────────────────────────────
    // A "login" endpoint that mints a JWT for the demo — Polaris verifies
    // tokens (`JwtAuth`/`require_jwt`), it does not itself provide a login
    // flow; a real service's own auth logic (password check, etc.) lives
    // here instead of this one-line stand-in.
    // BasicAuth: decode `Authorization: Basic base64(user:pass)` by hand —
    // no middleware needed, just the extractor.
    // Bearer: read the raw token, no verification (contrast with /private below).
    Router.new()
        .get("/public", fn(req ServerRequest) -> ServerResponse =>
            ServerResponse.text(StatusCode.OK, "public"))!!
        .get("/login/{user}", fn(req ServerRequest) -> ServerResponse {
            ro user = req.param("user") ?? "anonymous"
            ServerResponse.text(StatusCode.OK, mint_token(user))
        })!!
        .get("/basic", fn(req ServerRequest) -> ServerResponse {
            match BasicAuth.from_request(req) {
                Ok(a)  => ServerResponse.text(StatusCode.OK, "welcome, ${a.user()}")
                Err(e) => e.into_response()
            }
        })!!
        .get("/bearer", fn(req ServerRequest) -> ServerResponse {
            match Bearer.from_request(req) {
                Ok(b)  => ServerResponse.text(StatusCode.OK, "token=${b.token()}")
                Err(e) => e.into_response()
            }
        })!!
        .nest("/session", sess_r)!!
        .nest("/private", priv_r)!!
}

/// Canonical production shape (serving.md/overview.md): `main` IS the accept
/// loop, no `supervised { spawn { ... } }` wrapper needed — main-body runs as
/// its own fiber, so a blocking `serve_router` call works directly.
fn main() Net Time Detach -> () {
    with Random = seeded(42) {
        ro app = build_router()
        consume listener = TcpListener.bind("0.0.0.0:18086")!!
        println("listening on http://127.0.0.1:18086 — press Ctrl+C to stop")
        // `SessionStore` is an explicit resource (222.20 волна B: no ambient
        // default, unlike `Log`) — installed here, wrapping the whole accept
        // loop so every request's `session` raw-op reaches the same
        // in-memory store. `Random` (session-id generation) uses the demo's
        // `seeded()` test handler — production code installs a real
        // `Random.secure()` handler once that CSPRNG factory lands (open
        // question, spec/open-questions.md; NOT this example's job to fake).
        with SessionStore = memory_session_store(600_000) {
            serve_router(listener, app, ServerPolicy.new())
        }
    }
}
