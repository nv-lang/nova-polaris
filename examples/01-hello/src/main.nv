// SPDX-License-Identifier: MIT OR Apache-2.0
// Polaris example 01 — hello: the smallest possible HTTP server.
// By way of axum's own `hello-world` / Express's `app.get('/', ...)` hello.

module main

import polaris.{Router, ServerRequest, ServerResponse}
import polaris.net.{ServerPolicy}
import polaris.serve.{serve_router}
import polaris.{StatusCode}
import std.net.{TcpListener, SocketAddr}

fn build_router() -> Router =>
    Router.new()
    .get("/hello/{name}", fn(req ServerRequest) -> ServerResponse {
        ro name = req.param("name") ?? "world"
        ServerResponse.text(StatusCode.OK, "hello, ${name}")
    })!!
    .get("/", fn(req ServerRequest) -> ServerResponse =>
        ServerResponse.text(StatusCode.OK, "hello, world -- try GET /hello/{name}"))!!

/// The canonical production shape (serving.md/overview.md): `main` IS the
/// accept loop, no `supervised { spawn { ... } }` wrapper needed — main-body
/// runs as its own fiber, so a blocking `serve_router` call works directly.
fn main() Net Time Detach -> () {
    ro app = build_router()
    consume listener = TcpListener.bind("0.0.0.0:18082".to_socket_addr()!!)!!
    serve_router(listener, app, ServerPolicy.new())
}
