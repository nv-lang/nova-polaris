// SPDX-License-Identifier: MIT OR Apache-2.0
// Polaris example 04 — middleware: a custom middleware(fn(req, next)), @then
// composition, layer ordering, and two batteries (log, ratelimit).
// By way of: axum's tower-middleware showcase, Express's middleware chain.

module main

import polaris.{Router, ServerRequest, ServerResponse, Handler, Middleware, middleware}
import polaris.net.{ServerPolicy}
import polaris.serve.{serve_router}
import polaris.middleware.log.{AccessLog, logger}
import polaris.middleware.ratelimit.{RateLimit, ratelimit}
import polaris.{StatusCode}
import std.net.{TcpListener, SocketAddr}

// ── a custom middleware, batteries style: one flat closure, no nested
//    fn(next) -> Handler ceremony ────────────────────────────────────────

fn add_tag(tag str, next Handler, req ServerRequest) -> ServerResponse {
    mut resp = next(req)
    ro prev = resp.headers.get("x-order")
    ro prev_str = match prev { Some(hv) => match hv.to_str() { Ok(s) => s, Err(_) => "" }, None => "" }
    resp.header("x-order", if prev_str == "" { tag } else { "${tag},${prev_str}" })
    resp
}

fn tag_layer(tag str) -> Middleware {
    middleware(fn(req ServerRequest, next Handler) -> ServerResponse => add_tag(tag, next, req))
}

fn build_router() Time -> Router {
    ro r2 = Router.new()
        .layer(tag_layer("C").then(tag_layer("D")))
        .get("/y", fn(req ServerRequest) -> ServerResponse => ServerResponse.text(StatusCode.OK, "base"))!!

    ro r3 = Router.new()
        .layer(ratelimit(RateLimit.new(2, 1.0)))
        .get("/limited", fn(req ServerRequest) -> ServerResponse => ServerResponse.text(StatusCode.OK, "ok"))!!

    // One log line per request to stdout, for every route below.
    // The first .layer() call is the OUTERMOST wrap and runs FIRST at
    // request time: A -> B -> handler, so the unwinding order tags the
    // header "A,B" (see docs/middleware.md for why).
    // @then composes two middlewares into ONE — same net effect as two
    // separate .layer() calls, useful as a reusable stack.
    // ratelimit: a small burst, then 429 + Retry-After — try it twice fast.
    Router.new()
        .layer(logger(AccessLog.new()))
        .layer(tag_layer("A"))
        .layer(tag_layer("B"))
        .get("/x", fn(req ServerRequest) -> ServerResponse => ServerResponse.text(StatusCode.OK, "base"))!!
        .nest("/composed", r2)!!
        .nest("/rl", r3)!!
}

/// Canonical production shape (serving.md/overview.md): `main` IS the accept
/// loop, no `supervised { spawn { ... } }` wrapper needed — main-body runs as
/// its own fiber, so a blocking `serve_router` call works directly.
fn main() Net Time Detach -> () {
    ro app = build_router()
    consume listener = TcpListener.bind("0.0.0.0:18085".to_socket_addr()!!)!!
    serve_router(listener, app, ServerPolicy.new())
}
