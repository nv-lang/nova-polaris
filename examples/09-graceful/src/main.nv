// SPDX-License-Identifier: MIT OR Apache-2.0
// Polaris example 09 — graceful: `ServerPolicy`'s admission/limit knobs,
// `BackgroundTasks` running after the response is on the wire, and an
// honest look at what "graceful" does and doesn't mean here today.
// By way of: axum's `graceful-shutdown` + `key-value-store` examples.

module main

import polaris.{Router, ServerRequest, ServerResponse, BackgroundTasks}
import polaris.net.{ServerPolicy}
import polaris.serve.{serve_router, handle_connection_router}
import polaris.{StatusCode}
import std.net.{TcpListener, SocketAddr}

// ── ServerPolicy: the accept-loop/connection knobs, as a value ──────────
//
// This example cannot bind `serve_router` live (see examples/README.md —
// `undefined symbol: nova_fn_hook` in this toolchain snapshot), so the
// admission-control/deadline/body-cap behavior `ServerPolicy` buys a real
// accept loop is demonstrated as pure construction + fluent tuning here
// (the same thing docs/serving.md's own test does, socket-free), not wired
// into a live socket. `production_main()` below shows exactly how it would
// bind: `serve_router(listener, router, policy)`.
fn policy_report() -> str {
    ro p = ServerPolicy.new()
    mut q = ServerPolicy.new()
    q.max_inflight(64)
    q.max_body_bytes(4 * 1024 * 1024)
    "defaults: max_inflight=${p.max_inflight()} reject_with_503=${p.reject_with_503()} max_requests_per_conn=${p.max_requests_per_conn()} max_body_bytes=${p.max_body_bytes()}\ntuned:    max_inflight=${q.max_inflight()} max_body_bytes=${q.max_body_bytes()}"
}

fn build_router() -> Router {
    mut log []str = []
    mut r = Router.new()

    r.get("/health", fn(req ServerRequest) -> ServerResponse => ServerResponse.text(StatusCode.OK, "ok"))!!

    r.get("/policy", fn(req ServerRequest) -> ServerResponse => ServerResponse.text(StatusCode.OK, policy_report()))!!

    // BackgroundTasks: the response goes out FIRST ("queued"), the queued
    // work runs afterward — this part works over the plain connection
    // driver this example's `main()` already uses (`handle_connection`/
    // `handle_connection_router` call `@drain()` right after the response
    // bytes are written, same as the full `serve_router` accept loop would
    // — see docs/serving.md#background-tasks).
    r.get("/work", fn(req ServerRequest) -> ServerResponse {
        mut bg = BackgroundTasks.new()
        bg.add(|| { log.push("background task ran") })
        mut resp = ServerResponse.text(StatusCode.OK, "queued ${bg.task_count()} background task(s)")
        resp.background(bg)
        resp
    })!!

    r.get("/log", fn(req ServerRequest) -> ServerResponse {
        if log.len() == 0 { ServerResponse.text(StatusCode.OK, "(empty — hit /work first)") }
        else { ServerResponse.text(StatusCode.OK, log[log.len() - 1]) }
    })!!

    r
}

/// Canonical production shape (serving.md) — compile-checked, never called.
/// See examples/README.md for why `main()` below drives the loop by hand.
/// This is also where `ServerPolicy`'s admission control (`max_inflight`),
/// deadlines, and recover-500 (a caught handler panic -> `policy.panic_response()`)
/// actually take effect — none of that runs through this example's own
/// `main()` today.
fn production_main() Net Time Detach -> () {
    consume listener = TcpListener.bind(SocketAddr.from_str("0.0.0.0:18090")!!)!!
    mut policy = ServerPolicy.new()
    policy.max_inflight(64)
    serve_router(listener, build_router(), policy)
}

fn main() Net Detach -> () {
    ro app = build_router()
    supervised {
        spawn {
            consume listener = TcpListener.bind(SocketAddr.from_str("0.0.0.0:18090")!!)!!
            while true {
                match listener.accept() {
                    Ok(consume stream) => { ro _ = handle_connection_router(stream, app) }
                    Err(_) => ()
                }
            }
        }
    }
}
