// SPDX-License-Identifier: MIT OR Apache-2.0
// Polaris example 09 — graceful: `ServerPolicy`'s admission/limit knobs,
// `BackgroundTasks` running after the response is on the wire, and an
// honest look at what "graceful" does and doesn't mean here today.
// By way of: axum's `graceful-shutdown` + `key-value-store` examples.

module main

import polaris.{Router, ServerRequest, ServerResponse, BackgroundTasks}
import polaris.net.{ServerPolicy}
import polaris.serve.{serve_router}
import polaris.{StatusCode}
import std.net.{TcpListener}
import std.runtime.sync.{Mutex}

// ── SharedLog: a `Mutex`-guarded `[]str`, not a bare `mut log []str` ──────
//
// The router's `/work` and `/log` handlers each close over `log` and run on
// whichever fiber is driving THAT connection — `serve_router`'s own
// connection-per-fiber model (`polaris.net.serve_connection`) means two
// concurrent requests hit `/work` and `/log` on DIFFERENT fibers, so a bare
// captured `mut []str` (the shape this file used to have) is a real data
// race: one fiber's `log.push(...)` and another's `log.len()`/`log[...]`
// read are unsynchronized concurrent accesses to the SAME backing `Vec`.
// `SharedLog` closes that gap the same way `metrics.nv`'s own
// `MetricsRegistry` does (a `value` record over a `Mutex` + a reference-
// semantics field — every copy aliases the SAME lock and the SAME `Vec`):
// `@push`/`@last` both take the lock for the full read-modify/read, same
// `Mutex.@lock()`/`MutexGuard.@unlock()` shape `std/runtime/sync_test.nv`'s
// own `Mutex` test uses. Compiler-enforcement for THIS class of bug (a
// `mut`-captured value silently shared across handler fibers) is tracked
// separately for the integrator, `[M-router-handler-mut-capture-escape-
// soundness]` — not this package's own remit.
type SharedLog value {
    priv lock  Mutex
    priv lines []str
}

fn SharedLog.new() -> SharedLog => { lock: Mutex.new(), lines: [] }

fn SharedLog @push(line str) {
    consume g = @lock.lock()
    @lines.push(line)
}

fn SharedLog @last() -> str {
    consume g = @lock.lock()
    ro n = @lines.len()
    ro v = if n == 0 { "(empty — hit /work first)" } else { @lines[n - 1] }
    v
}

// ── ServerPolicy: the accept-loop/connection knobs, as a value ──────────
//
// `tuned_policy()` is the ONE place the "tuned" knobs are set — `/policy`
// below reports it, and `main()` binds the very same construction into the
// live `serve_router` accept loop, so what `/policy` prints is exactly what
// governs the real socket, not just illustrative (docs/serving.md's own
// `ServerPolicy` test does the pure construction/fluent-tuning half,
// socket-free).
fn tuned_policy() -> ServerPolicy {
    mut q = ServerPolicy.new()
    q.max_inflight(64)
    q.max_body_bytes(4 * 1024 * 1024)
    q
}

fn policy_report() -> str {
    ro p = ServerPolicy.new()
    ro q = tuned_policy()
    "defaults: max_inflight=${p.max_inflight()} reject_with_503=${p.reject_with_503()} max_requests_per_conn=${p.max_requests_per_conn()} max_body_bytes=${p.max_body_bytes()}\ntuned:    max_inflight=${q.max_inflight()} max_body_bytes=${q.max_body_bytes()}"
}

fn build_router() -> Router {
    mut log = SharedLog.new()

    Router.new()
        .get("/health", fn(req ServerRequest) -> ServerResponse => ServerResponse.text(StatusCode.OK, "ok"))!!
        .get("/policy", fn(req ServerRequest) -> ServerResponse => ServerResponse.text(StatusCode.OK, policy_report()))!!
        // BackgroundTasks: the response goes out FIRST ("queued"), the queued
        // work SHOULD run afterward — but as of this comment (2026-08-01
        // manual smoke, race-fix window), it does NOT: `serve_router`'s own
        // connection driver goes through `net/serve.nv`'s `run_request`,
        // which never calls `resp.take_background()`/`tasks.drain()`
        // anywhere in its body — unlike `servernet.nv`'s OLDER single-shot
        // `handle_connection`, which does (`run_background(bg)` after a
        // successful write). Confirmed against an unmodified copy of this
        // file (git HEAD, pre-race-fix): `/work` then `/log` shows
        // "(empty — hit /work first)" even seconds later, same as with this
        // fix applied — a PRE-EXISTING, independent defect (BackgroundTasks
        // queued through the keep-alive `serve_router` path never execute),
        // not introduced or fixed by the `SharedLog` change below. Reported
        // for the integrator; out of this task's own remit (a data-race
        // fix, not a `serve.nv` behavior fix).
        // `log` is a `SharedLog` (`Mutex`-guarded) — `/work`'s background
        // task and `/log`'s read run on different connections' fibers, so
        // both go through the SAME lock (see `SharedLog`'s own banner above)
        // — moot until the drain gap above is closed, but still the correct
        // shape once it is.
        .get("/work", fn(req ServerRequest) -> ServerResponse {
            mut bg = BackgroundTasks.new()
            bg.add(|| { log.push("background task ran") })
            mut resp = ServerResponse.text(StatusCode.OK, "queued ${bg.task_count()} background task(s)")
            resp.background(bg)
            resp
        })!!
        .get("/log", fn(req ServerRequest) -> ServerResponse => ServerResponse.text(StatusCode.OK, log.last()))!!
}

/// Canonical production shape (serving.md/overview.md): `main` IS the accept
/// loop, no `supervised { spawn { ... } }` wrapper needed — main-body runs as
/// its own fiber, so a blocking `serve_router` call works directly. This is
/// also where `ServerPolicy`'s admission control (`max_inflight`), deadlines,
/// and recover-500 (a caught handler panic -> `policy.panic_response()`)
/// actually take effect, over the real accept loop.
fn main() Net Time Detach -> () {
    ro app = build_router()
    consume listener = TcpListener.bind("0.0.0.0:18090")!!
    serve_router(listener, app, tuned_policy())
}
