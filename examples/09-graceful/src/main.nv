// SPDX-License-Identifier: MIT OR Apache-2.0
// Polaris example 09 — graceful: `ServerPolicy`'s admission/limit knobs,
// `BackgroundTasks` running after the response is on the wire, and an
// honest look at what "graceful" does and doesn't mean here today.
// By way of: axum's `graceful-shutdown` + `key-value-store` examples.

module main

import polaris.{Router, ServerRequest, ServerResponse, BackgroundTasks}
import polaris.net.{ServerPolicy}
import polaris.serve.{serve_router}
import polaris.{StatusCode}
import std.net.{TcpListener, SocketAddr}

// ── ServerPolicy: the accept-loop/connection knobs, as a value ──────────
//
// `tuned_policy()` is the ONE place the "tuned" knobs are set — `/policy`
// below reports it, and `main()` binds the very same construction into the
// live `serve_router` accept loop, so what `/policy` prints is exactly what
// governs the real socket, not just illustrative (docs/serving.md's own
// `ServerPolicy` test does the pure construction/fluent-tuning half,
// socket-free).
fn tuned_policy() -> ServerPolicy {
    mut q = ServerPolicy.new()
    q.max_inflight(64)
    q.max_body_bytes(4 * 1024 * 1024)
    q
}

fn policy_report() -> str {
    ro p = ServerPolicy.new()
    ro q = tuned_policy()
    "defaults: max_inflight=${p.max_inflight()} reject_with_503=${p.reject_with_503()} max_requests_per_conn=${p.max_requests_per_conn()} max_body_bytes=${p.max_body_bytes()}\ntuned:    max_inflight=${q.max_inflight()} max_body_bytes=${q.max_body_bytes()}"
}

fn build_router() -> Router {
    mut log []str = []

    Router.new()
        .get("/health", fn(req ServerRequest) -> ServerResponse => ServerResponse.text(StatusCode.OK, "ok"))!!
        .get("/policy", fn(req ServerRequest) -> ServerResponse => ServerResponse.text(StatusCode.OK, policy_report()))!!
        // BackgroundTasks: the response goes out FIRST ("queued"), the queued
        // work runs afterward — `serve_router`'s own connection driver
        // (`polaris.net.serve_connection`) calls `@drain()` right after the
        // response bytes are written, same as the single-shot
        // `handle_connection_router` would (see docs/serving.md#background-tasks).
        .get("/work", fn(req ServerRequest) -> ServerResponse {
            mut bg = BackgroundTasks.new()
            bg.add(|| { log.push("background task ran") })
            mut resp = ServerResponse.text(StatusCode.OK, "queued ${bg.task_count()} background task(s)")
            resp.background(bg)
            resp
        })!!
        .get("/log", fn(req ServerRequest) -> ServerResponse {
            if log.len() == 0 { ServerResponse.text(StatusCode.OK, "(empty — hit /work first)") }
            else { ServerResponse.text(StatusCode.OK, log[log.len() - 1]) }
        })!!
}

/// Canonical production shape (serving.md/overview.md): `main` IS the accept
/// loop, no `supervised { spawn { ... } }` wrapper needed — main-body runs as
/// its own fiber, so a blocking `serve_router` call works directly. This is
/// also where `ServerPolicy`'s admission control (`max_inflight`), deadlines,
/// and recover-500 (a caught handler panic -> `policy.panic_response()`)
/// actually take effect, over the real accept loop.
fn main() Net Time Detach -> () {
    ro app = build_router()
    consume listener = TcpListener.bind(SocketAddr.from_str("0.0.0.0:18090")!!)!!
    serve_router(listener, app, tuned_policy())
}
