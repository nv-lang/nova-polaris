// SPDX-License-Identifier: MIT OR Apache-2.0
// Polaris example 08 — websocket-echo: a real RFC 6455 handshake + echo
// loop over a live loopback socket, through the canonical `Router` +
// `WebSocketUpgrade` extractor (docs/websocket.md) — same shape
// `src/rt/ws_upgrade_hijack_smoke.nv` proves end-to-end through
// `serve_connection` (the driver `serve_router`'s accept loop is built on).
// By way of: axum's `websockets` example.

module main

import polaris.{Router, ServerRequest, ServerResponse, WebSocketUpgrade, StatusCode}
import polaris.ws.{WebSocket, Message}
import polaris.net.{ServerPolicy}
import polaris.serve.{serve_router}
import std.net.{TcpListener, SocketAddr}

// `WebSocketUpgrade.from_request` validates the handshake (method/Upgrade/
// Connection/Sec-WebSocket-Version/-Key) as a normal `FromRequest` extractor
// — a malformed request is a typed 400, no socket work happens. `up.
// on_upgrade(h)` writes the 101 response, then hands the live `WebSocket` to
// `h`, which owns it from then on (`consume`, D133 — closing it is checked
// at compile time).
fn ws_echo_handler(req ServerRequest) -> ServerResponse {
    match WebSocketUpgrade.from_request(req) {
        Ok(up) => up.on_upgrade(fn(sock WebSocket) Net -> () {
            // `w`, NOT `ws` — this file also imports the `polaris.ws` MODULE
            // (`polaris.ws.{WebSocket, Message}`), and a local named `ws`
            // shadows it into an [E7401] "no function ... in module `ws`"
            // resolution error at every `.recv()`/`.send()`/`.close()` call
            // below (found compiling this file); `ws_upgrade_hijack_smoke.nv`
            // sidesteps the same clash the identical way (`mut w = ws`).
            mut w = sock
            mut running = true
            while running {
                match w.recv() {
                    Ok(Some(Message.Text(t)))   => { ro _ = w.send(Message.Text(t)) }   // echo
                    Ok(Some(Message.Binary(b))) => { ro _ = w.send(Message.Binary(b)) } // echo
                    Ok(Some(_))                 => ()                                  // Ping already auto-Ponged
                    Ok(None)                    => { running = false }
                    Err(_)                      => { running = false }
                }
            }
            ro _ = w.close(1000, "bye")
        })
        Err(e) => e.into_response()
    }
}

fn build_router() -> Router =>
    Router.new()
        .get("/ws", ws_echo_handler)!!
        .get("/health", fn(req ServerRequest) -> ServerResponse => ServerResponse.text(StatusCode.OK, "ok"))!!

/// Canonical production shape (serving.md/overview.md, docs/websocket.md):
/// `main` IS the accept loop, no `supervised { spawn { ... } }` wrapper
/// needed — main-body runs as its own fiber. The ws-hijack hook
/// `up.on_upgrade` installs is checked by `serve_router`'s own connection
/// driver (`polaris.net.serve_connection`'s `run_request`, right after the
/// 101 bytes are written) — no hand-rolled accept loop needed for WebSocket
/// upgrades any more.
fn main() Net Time Detach -> () {
    ro app = build_router()
    consume listener = TcpListener.bind(SocketAddr.from_str("0.0.0.0:18089")!!)!!
    serve_router(listener, app, ServerPolicy.new())
}
