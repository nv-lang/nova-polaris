// SPDX-License-Identifier: MIT OR Apache-2.0
// Polaris example 06 — static-site: embedded static assets, index-file
// fallback at the root, and a Cache-Control header on every response.
// By way of: axum's `static-file-server` example.

module main

import polaris.{Router, ServerRequest, ServerResponse}
import polaris.static.{Static, serve_path}
import polaris.net.{ServerPolicy}
import polaris.serve.{serve_router, handle_connection_router}
import std.net.{TcpListener, SocketAddr}

fn site() -> EmbeddedDir =>
    EmbeddedDir.new([
        EmbeddedEntry { path: "index.html", data: "<h1>Polaris static-site example</h1><p>Try /assets/style.css or /assets/notes/hello.txt</p>".bytes() },
        EmbeddedEntry { path: "notes/hello.txt", data: "hello from an embedded, nested asset".bytes() },
        EmbeddedEntry { path: "style.css", data: "body { font-family: sans-serif; }".bytes() },
    ])

fn static_config() -> Static {
    mut cfg = Static.new()
    cfg.cache_control("public, max-age=3600")
    cfg
}

fn build_router() -> Router {
    mut r = Router.new()

    // Root: no {*path} capture is available at "/" itself, so the index
    // file is served by calling `serve_path` directly with an empty path —
    // the same fallback `static_handler` performs internally for a
    // trailing-`/` request under `/assets/`.
    r.get("/", fn(req ServerRequest) -> ServerResponse =>
        serve_path(site(), static_config(), "", req))!!

    // `static_handler(fs, cfg, param)` (the one-call ready-`Handler` helper
    // documented in static-files.md) currently hits a codegen gap for this
    // package's own `EmbeddedDir` (`out of memory` on the very first served
    // asset — isolated during this wave, filed upstream); calling
    // `serve_path` directly from a plain closure, the same shape the root
    // route above already uses, is unaffected and is exactly what
    // `static_handler` does internally (see its own one-line body in
    // `src/static.nv`).
    r.get("/assets/{*path}", fn(req ServerRequest) -> ServerResponse =>
        serve_path(site(), static_config(), req.param("path") ?? "", req))!!

    r
}

/// Canonical production shape (serving.md) — compile-checked, never called.
/// See examples/README.md for why `main()` below drives the loop by hand.
fn production_main() Net Time Detach -> () {
    consume listener = TcpListener.bind(SocketAddr.from_str("0.0.0.0:18087")!!)!!
    serve_router(listener, build_router(), ServerPolicy.new())
}

fn main() Net Detach -> () {
    ro app = build_router()
    supervised {
        spawn {
            consume listener = TcpListener.bind(SocketAddr.from_str("0.0.0.0:18087")!!)!!
            while true {
                match listener.accept() {
                    Ok(consume stream) => { ro _ = handle_connection_router(stream, app) }
                    Err(_) => ()
                }
            }
        }
    }
}
