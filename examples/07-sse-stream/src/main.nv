// SPDX-License-Identifier: MIT OR Apache-2.0
// Polaris example 07 — sse-stream: a live ticker over Server-Sent Events,
// via a pull-based `StreamBody` producer (`stream_body(f)`), not a
// pre-built finite chunk list.
// By way of: axum's `sse` example.

module main

import polaris.{Router, ServerRequest, ServerResponse, StreamBody, stream_body, sse_event}
import polaris.net.{ServerPolicy}
import polaris.serve.{serve_router}
import polaris.{StatusCode}
import std.net.{TcpListener}
import std.io.{println}

// `stream_body(f)` wraps a closure `fn() -> Option[[]u8]` — called once per
// chunk, `None` ends the stream. This ticker counts down from 5 and emits
// one `tick` SSE event per call, then a final `done` event, then ends —
// the live-socket connection driver writes each chunk with its own
// `write_all` as it is produced (see docs/serving.md#streaming-and-sse);
// `serve_once` (the docs' own socket-free tests) instead drains a producer
// like this one eagerly into a single buffer.
fn ticker(remaining int) -> StreamBody {
    mut n = remaining
    stream_body(fn() -> Option[[]u8] {
        if n > 0 {
            ro chunk = sse_event("tick", "${n}")
            n -= 1
            Some(chunk)
        } else if n == 0 {
            n -= 1 // one extra call emits the closing event, then truly ends
            Some(sse_event("done", "bye"))
        } else {
            None
        }
    })
}

fn build_router() -> Router =>
    Router.new()
        .get("/events", fn(req ServerRequest) -> ServerResponse =>
            ServerResponse.sse(ticker(5)))!!
        .get("/health", fn(req ServerRequest) -> ServerResponse =>
            ServerResponse.text(StatusCode.OK, "ok"))!!

/// Canonical production shape (serving.md/overview.md): `main` IS the accept
/// loop, no `supervised { spawn { ... } }` wrapper needed — main-body runs as
/// its own fiber, so a blocking `serve_router` call works directly. Streaming
/// works the same way through `serve_router`'s own connection driver
/// (`polaris.net.serve_connection`'s `write_response_keepalive` checks
/// `resp.is_streaming()`) as it does over the single-shot
/// `handle_connection_router` — no special-casing needed here.
fn main() Net Time Detach -> () {
    ro app = build_router()
    consume listener = TcpListener.bind("0.0.0.0:18088")!!
    println("listening on http://127.0.0.1:18088 — press Ctrl+C to stop")
    serve_router(listener, app, ServerPolicy.new())
}
